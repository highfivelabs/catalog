{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "firewall-rules values (terraform-google-network modules/firewall-rules v18.3.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "network_name"],
  "definitions": {
    "stringList": {"type": ["array", "null"], "items": {"type": "string"}},
    "ports": {"type": ["array", "null"], "items": {"type": ["string", "integer"]}},
    "protocols": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol"],
        "properties": {
          "protocol": {"type": "string", "minLength": 1},
          "ports": {"$ref": "#/definitions/ports"}
        }
      }
    },
    "logConfig": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["metadata"],
      "properties": {
        "metadata": {"type": "string", "enum": ["EXCLUDE_ALL_METADATA", "INCLUDE_ALL_METADATA"]}
      }
    },
    "priority": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
    "rule": {
      "description": "A rule of rules (deprecated): ranges are source ranges for INGRESS, destination ranges for EGRESS.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "direction": {"type": ["string", "null"], "enum": ["INGRESS", "EGRESS", null]},
        "disabled": {"type": ["boolean", "null"]},
        "priority": {"$ref": "#/definitions/priority"},
        "ranges": {"$ref": "#/definitions/stringList"},
        "source_tags": {"$ref": "#/definitions/stringList"},
        "source_service_accounts": {"$ref": "#/definitions/stringList"},
        "target_tags": {"$ref": "#/definitions/stringList"},
        "target_service_accounts": {"$ref": "#/definitions/stringList"},
        "allow": {"$ref": "#/definitions/protocols"},
        "deny": {"$ref": "#/definitions/protocols"},
        "log_config": {"$ref": "#/definitions/logConfig"}
      }
    },
    "directedRule": {
      "description": "A rule of ingress_rules or egress_rules.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "disabled": {"type": ["boolean", "null"]},
        "priority": {"$ref": "#/definitions/priority"},
        "destination_ranges": {"$ref": "#/definitions/stringList"},
        "source_ranges": {"$ref": "#/definitions/stringList"},
        "source_tags": {"$ref": "#/definitions/stringList"},
        "source_service_accounts": {"$ref": "#/definitions/stringList"},
        "target_tags": {"$ref": "#/definitions/stringList"},
        "target_service_accounts": {"$ref": "#/definitions/stringList"},
        "allow": {"$ref": "#/definitions/protocols"},
        "deny": {"$ref": "#/definitions/protocols"},
        "log_config": {"$ref": "#/definitions/logConfig"}
      }
    }
  },
  "properties": {
    "names": {
      "type": "object",
      "additionalProperties": false,
      "description": "Collision-prone cloud names set in full (not Terraform variables; docs/design.md, \"Names, labels and tags\"). This chart has none: every rule names itself in its entry.",
      "properties": {}
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every rule's name. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object.",
      "type": ["object", "null"],
      "additionalProperties": {"type": "string", "maxLength": 63}
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -). Firewall rules take none.",
      "type": ["object", "null"],
      "propertyNames": {"pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"},
      "additionalProperties": {"type": "string", "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"}
    },
    "deletion_policy": {
      "enum": ["DELETE", "ABANDON", "PREVENT", null],
      "description": "Not a module variable. PREVENT is refused (no Config Connector equivalent)."
    },
    "project_id": {"type": "string", "minLength": 1, "description": "Project id of the project that holds the network. Required."},
    "network_name": {"type": "string", "minLength": 1, "description": "Name of the network this set of firewall rules applies to. Required."},
    "rules": {"type": ["array", "null"], "items": {"$ref": "#/definitions/rule"}},
    "ingress_rules": {"type": ["array", "null"], "items": {"$ref": "#/definitions/directedRule"}},
    "egress_rules": {"type": ["array", "null"], "items": {"$ref": "#/definitions/directedRule"}}
  }
}

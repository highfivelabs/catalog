{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gke-cluster-standard values (fabric gke-cluster-standard v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location",
    "name",
    "project_id",
    "vpc_config"
  ],
  "properties": {
    "names": {
      "description": "The cluster's and the notifications topic's names in full (not Terraform variables). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "topic": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z][-A-Za-z0-9_.~+%]*$"
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every derived name. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "fabric's labels (the cluster's resource labels): Kubernetes labels on every object; an unprefixed key also becomes a Google Cloud label.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource that takes them.",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },

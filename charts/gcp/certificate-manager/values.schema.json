{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "certificate-manager values (fabric certificate-manager v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id"
  ],
  "properties": {
    "names": {
      "description": "The certificate map's name in full (not a Terraform variable; docs/design.md, \"Names, labels and tags\"). A name set here takes no namePrefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "map": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every name the chart gives. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "certificates": {
      "description": "Certificates.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "labels": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ALL_REGIONS",
              "CLIENT_AUTH",
              "DEFAULT",
              "EDGE_CACHE",
              null
            ]
          },
          "self_managed": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "pem_certificate",
              "pem_private_key"
            ],
            "properties": {
              "pem_certificate": {
                "type": "string"
              },
              "pem_private_key": {
                "type": "string"
              }
            }
          },
          "managed": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "domains"
            ],
            "properties": {
              "domains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dns_authorizations": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "issuance_config": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "dns_authorizations": {
      "description": "DNS authorizations.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "FIXED_RECORD",
              "PER_PROJECT_RECORD",
              null
            ]
          },
          "labels": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "issuance_configs": {
      "description": "Issuance configs.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ca_pool",
          "key_algorithm",
          "lifetime",
          "rotation_window_percentage"
        ],
        "properties": {
          "ca_pool": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "key_algorithm": {
            "type": "string"
          },
          "labels": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "lifetime": {
            "type": "string"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "rotation_window_percentage": {
            "type": "number"
          }
        }
      }
    },
    "map": {
      "description": "Map attributes.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "entries": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "certificates"
            ],
            "properties": {
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hostname": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "labels": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              },
              "matcher": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "certificates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "project_id": {
      "description": "Project id.",
      "type": "string",
      "minLength": 1
    },
    "deletion_policy": {
      "description": "Not a fabric variable: DELETE (default) or ABANDON keeps the cloud resources when the component is deleted.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    }
  }
}

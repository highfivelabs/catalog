# What the live case makes (hack/live-apply.sh, "A case can also live beside its chart"), children first.
certificate-manager maps entries describe ${RUN}-entry --map ${RUN}-map
certificate-manager maps describe ${RUN}-map
certificate-manager certificates describe ${RUN}-cert
certificate-manager dns-authorizations describe ${RUN}-dns
certificate-manager issuance-configs describe ${RUN}-ic --location global
privateca pools describe ${RUN}-pool --location ${REGION}

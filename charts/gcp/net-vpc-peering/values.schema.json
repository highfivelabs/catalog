{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "net-vpc-peering values (fabric net-vpc-peering v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "local_network",
    "peer_network"
  ],
  "properties": {
    "names": {
      "description": "The peerings' names in full (not Terraform variables; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "peer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of the derived peering names. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "local_network": {
      "description": "Resource link of the network to add a peering to.",
      "type": "string",
      "minLength": 1
    },
    "name": {
      "description": "Optional names for the peering resources.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local": {
          "type": [
            "string",
            "null"
          ]
        },
        "peer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "peer_create_peering": {
      "description": "Create the peering on the remote side.",
      "type": "boolean"
    },
    "peer_network": {
      "description": "Resource link of the peer network.",
      "type": "string",
      "minLength": 1
    },
    "prefix": {
      "description": "Optional name prefix for the network peerings. Prefix cannot be empty, please use null instead.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "routes_config": {
      "description": "Route import and export for the local and the peer side.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "export": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "import": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "public_export": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "public_import": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "peer": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "export": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "import": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "public_export": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "public_import": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "stack_type": {
      "description": "The stack_type must be either 'IPV4_ONLY' or 'IPV4_IPV6'.",
      "enum": [
        "IPV4_ONLY",
        "IPV4_IPV6",
        null
      ]
    },
    "deletion_policy": {
      "description": "DELETE (default) or ABANDON (not a fabric variable).",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    }
  }
}

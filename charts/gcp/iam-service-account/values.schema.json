{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "iam-service-account values (fabric iam-service-account v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "definitions": {
    "condition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["expression", "title"],
      "properties": {
        "expression": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": ["string", "null"]}
      }
    },
    "rolesByKey": {
      "description": "{KEY: [ROLES]}",
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "membersByRole": {
      "description": "{ROLE: [MEMBERS]}",
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "iamBindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["members", "role"],
        "properties": {
          "members": {"type": "array", "items": {"type": "string"}},
          "role": {"type": "string"},
          "condition": {"$ref": "#/definitions/condition"}
        }
      }
    },
    "iamBindingsAdditive": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "role"],
        "properties": {
          "member": {"type": "string"},
          "role": {"type": "string"},
          "condition": {"$ref": "#/definitions/condition"}
        }
      }
    },
    "grantsTo": {
      "description": "{KEY: {<id field>, role, condition}}: roles granted to this service account on another resource",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": {"type": "string"},
          "condition": {"$ref": "#/definitions/condition"}
        }
      }
    }
  },
  "properties": {
    "names": {
      "description": "Collision-prone cloud names set in full (not Terraform variables; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix; one not set derives from name.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceAccount": {"description": "The account ID in full (6 to 30 characters).", "type": "string", "minLength": 6, "maxLength": 30}
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every derived cloud name, never one set under names. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object; an unprefixed key also becomes a Google Cloud label (Config Connector copies it).",
      "type": ["object", "null"],
      "additionalProperties": {"type": "string", "maxLength": 63}
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": ["object", "null"],
      "propertyNames": {"pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"},
      "additionalProperties": {"type": "string", "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"}
    },
    "name": {
      "description": "Name of the service account to create.",
      "type": "string",
      "minLength": 1
    },
    "prefix": {
      "description": "Prefix applied to service account names. Cannot be empty: use null.",
      "type": ["string", "null"],
      "minLength": 1
    },
    "project_id": {"description": "Project where the service account is created; null takes the namespace's.", "type": ["string", "null"]},
    "project_number": {"description": "Unused: Config Connector reads the number.", "type": ["string", "number", "null"]},
    "display_name": {"description": "Display name of the service account to create.", "type": ["string", "null"]},
    "description": {"description": "Optional description.", "type": ["string", "null"]},
    "deletion_policy": {
      "description": "Deletion policy: DELETE or ABANDON. PREVENT is refused at render.",
      "type": ["string", "null"],
      "enum": ["DELETE", "ABANDON", "PREVENT", null]
    },
    "iam": {"$ref": "#/definitions/membersByRole"},
    "iam_by_principals": {"$ref": "#/definitions/rolesByKey"},
    "allow_alpha": {"description": "Accept features that need an alpha (v1alpha1) kind: iam_bindings as IAMBinding objects.", "type": "boolean"},
    "iam_bindings": {"$ref": "#/definitions/iamBindings"},
    "iam_bindings_additive": {"$ref": "#/definitions/iamBindingsAdditive"},
    "iam_by_principals_additive": {"$ref": "#/definitions/rolesByKey"},
    "iam_billing_roles": {"$ref": "#/definitions/rolesByKey"},
    "iam_billing_bindings": {"$ref": "#/definitions/grantsTo"},
    "iam_folder_roles": {"$ref": "#/definitions/rolesByKey"},
    "iam_folder_bindings": {"$ref": "#/definitions/grantsTo"},
    "iam_organization_roles": {"$ref": "#/definitions/rolesByKey"},
    "iam_organization_bindings": {"$ref": "#/definitions/grantsTo"},
    "iam_project_roles": {"$ref": "#/definitions/rolesByKey"},
    "iam_project_bindings": {"$ref": "#/definitions/grantsTo"},
    "iam_sa_roles": {"$ref": "#/definitions/rolesByKey"},
    "iam_sa_bindings": {"$ref": "#/definitions/grantsTo"},
    "iam_storage_roles": {"$ref": "#/definitions/rolesByKey"},
    "iam_storage_bindings": {"$ref": "#/definitions/grantsTo"},
    "service_account_reuse": {"description": "Not supported: a reused account is a reference, not a component.", "type": ["object", "null"]},
    "create_ignore_already_exists": {"description": "Not supported: Config Connector acquires an existing account by resourceID.", "type": ["boolean", "null"]},
    "tag_bindings": {"description": "Not supported: a tag binding's parent needs the account's unique ID, known only after apply.", "type": "object"},
    "context": {"description": "Not supported: use Bundt's ${...} expressions and valueFrom instead.", "type": "object"}
  }
}

      "properties": {
        "taxonomy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of the taxonomy's display name. A DNS label. Empty changes nothing.",

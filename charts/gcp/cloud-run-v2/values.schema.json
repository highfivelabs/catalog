{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cloud-run-v2 values (fabric cloud-run-v2 v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "project_id",
    "region"
  ],
  "properties": {
    "names": {
      "description": "Cloud names in full (not Terraform variables; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 49,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "job": {
          "type": "string",
          "minLength": 1,
          "maxLength": 49,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "workerPool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 49,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "serviceAccount": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])$"
        },
        "vpcConnector": {
          "type": "string",
          "minLength": 2,
          "maxLength": 25,
          "pattern": "^[a-z][-a-z0-9]*[a-z0-9]$"
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every derived name, never a name set under names. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object; an unprefixed key also becomes a Google Cloud label. fabric's labels.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "allow_alpha": {
      "description": "Accept the v1alpha1 kind RunWorkerPool (type WORKERPOOL). Not a fabric variable.",
      "type": "boolean"
    },
    "deletion_policy": {
      "description": "DELETE (default) or ABANDON (not a fabric variable).",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },

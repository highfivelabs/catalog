{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cloud-identity-group values (fabric cloud-identity-group v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "customer_id",
    "display_name",
    "name"
  ],
  "properties": {
    "names": {
      "description": "The group's key (email address) in full (not a Terraform variable; docs/design.md, \"Names, labels and tags\").",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable). A group's name is an email address, so it takes none. A DNS label.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "customer_id": {
      "description": "Directory customer ID in the form customers/C0xxxxxxx.",
      "type": "string",
      "pattern": "^customers/C0[a-z0-9]{7}$"
    },
    "description": {
      "description": "Group description.",
      "type": [
        "string",
        "null"
      ]
    },
    "display_name": {
      "description": "Group display name.",
      "type": "string",
      "minLength": 1
    },
    "managers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "List of group managers."
    },
    "members": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "List of group members."
    },
    "name": {
      "description": "Group ID (usually an email).",
      "type": "string",
      "minLength": 1
    },
    "deletion_policy": {
      "description": "Not a fabric variable: DELETE (default) or ABANDON. PREVENT has no Config Connector equivalent.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "DELETE",
        "ABANDON",
        "PREVENT"
      ]
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "spanner-instance values (fabric spanner-instance v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance",
    "project_id"
  ],
  "properties": {
    "names": {
      "description": "The instance ID in full (not a Terraform variable; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][-a-z0-9]*[a-z0-9]$"
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of the instance ID. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object; an unprefixed key is also a Google Cloud label on the instance and the instance configuration.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource that takes them (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "databases": {
      "description": "Databases.",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,28}[a-z0-9]$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "database_dialect": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "GOOGLE_STANDARD_SQL",
              "POSTGRESQL",
              null
            ]
          },
          "ddl": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "default_time_zone": {
            "type": [
              "string",
              "null"
            ]
          },
          "deletion_protection": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "enable_drop_protection": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "iam": {
            "description": "IAM bindings in {ROLE => [MEMBERS]} format.",
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "iam_bindings": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "members",
                "role"
              ],
              "properties": {
                "members": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "role": {
                  "type": "string"
                },
                "condition": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "expression",
                    "title"
                  ],
                  "properties": {
                    "expression": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "iam_bindings_additive": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "member",
                "role"
              ],
              "properties": {
                "member": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "condition": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "expression",
                    "title"
                  ],
                  "properties": {
                    "expression": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "kms_key_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "version_retention_period": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "\\d+[smhd]"
          }
        }
      }
    },
    "iam": {
      "description": "IAM bindings in {ROLE => [MEMBERS]} format.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_bindings": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "members",
          "role"
        ],
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string"
          }
        }
      },
      "description": "Authoritative IAM bindings in {KEY => {role = ROLE, members = []}}. Keys are arbitrary."
    },
    "iam_bindings_additive": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member",
          "role"
        ],
        "properties": {
          "member": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "description": "Individual additive IAM bindings. Keys are arbitrary."
    },
    "instance": {
      "description": "Instance attributes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "autoscaling": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "max_nodes": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "max_processing_units": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "min_nodes": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "min_processing_units": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            },
            "targets": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "high_priority_cpu_utilization_percent": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "storage_utilization_percent": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "config": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "auto_create": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "replicas"
              ],
              "properties": {
                "base_config": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "display_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "labels": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "replicas": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "location",
                      "type",
                      "default_leader_location"
                    ],
                    "properties": {
                      "location": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "default_leader_location": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_backup_schedule_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "num_nodes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "processing_units": {
          "type": [
            "integer",
            "null"
          ]
        },
        "force_destroy": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "instance_create": {
      "description": "Set to false to manage databases and IAM bindings in an existing instance.",
      "type": "boolean"
    },
    "project_id": {
      "description": "Project id.",
      "type": "string",
      "minLength": 1
    },
    "deletion_policy": {
      "description": "Not a fabric variable: DELETE (default) or ABANDON; PREVENT is refused.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    }
  }
}

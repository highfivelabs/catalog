{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "source-repository values (fabric source-repository v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "project_id"
  ],
  "properties": {
    "names": {
      "description": "The repository's name in full (not a Terraform variable; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of the derived repository and trigger names. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "iam": {
      "description": "IAM bindings in {ROLE => [MEMBERS]} format.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_bindings": {
      "description": "Authoritative IAM bindings in {KEY => {role = ROLE, members = [], condition = {}}}. Keys are arbitrary.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "members",
          "role"
        ],
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "expression",
              "title"
            ],
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "iam_bindings_additive": {
      "description": "Individual additive IAM bindings. Keys are arbitrary.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member",
          "role"
        ],
        "properties": {
          "member": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "expression",
              "title"
            ],
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "iam_by_principals": {
      "description": "Authoritative IAM binding in {PRINCIPAL => [ROLES]} format. Merged internally with the iam variable.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "name": {
      "description": "Repository name.",
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "description": "Project used for resources.",
      "type": "string",
      "minLength": 1
    },
    "triggers": {
      "description": "Cloud Build triggers.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "included_files",
          "service_account",
          "substitutions",
          "template"
        ],
        "properties": {
          "filename": {
            "type": "string"
          },
          "included_files": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "service_account": {
            "type": [
              "string",
              "null"
            ]
          },
          "substitutions": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "template": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "branch_name",
              "project_id",
              "tag_name"
            ],
            "properties": {
              "branch_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "project_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tag_name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "deletion_policy": {
      "description": "Not a fabric variable: DELETE (default) or ABANDON. PREVENT has no Config Connector equivalent.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "DELETE",
        "ABANDON",
        "PREVENT"
      ]
    }
  }
}

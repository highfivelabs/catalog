{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "geap-agent-gateway values (fabric geap-agent-gateway v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "project_id",
    "region"
  ],
  "properties": {
    "names": {
      "description": "Cloud names in full (not a Terraform variable; docs/design.md, \"Names, labels and tags\"): gateway, connectivityTemplate. A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gateway": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "connectivityTemplate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every name not set under names. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object; an unprefixed key also becomes a Google Cloud label on the gateway and the connectivity template (fabric's labels variable).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on the gateway and the connectivity template (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "allow_alpha": {
      "description": "Accept config-connector-extensions' v1alpha1 kinds (not a Terraform variable). Both of this chart's kinds are v1alpha1, so it is required.",
      "type": "boolean"
    },
    "deletion_policy": {
      "description": "DELETE (default) or ABANDON (not a fabric variable).",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "access_path": {
      "description": "ingress (or CLIENT_TO_AGENT), egress (or AGENT_TO_ANYWHERE).",
      "type": [
        "string",
        "null"
      ]
    },
    "access_policies": {
      "description": "IAM v3 access policies and their bindings, keyed by policy ID: rules make a project IAMAccessPolicy, bind (default true) an IAMPolicyBinding to target_resource (project, gateway or a URI); policy_reuse binds an existing policy.",
      "type": [
        "object",
        "null"
      ]
    },
    "context": {
      "description": "Context-specific interpolations. Refused when set (use Bundt expressions).",
      "type": [
        "object",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "iap_config": {
      "description": "Identity-Aware Proxy request authorization. Refused unless null: the authorization policy binding it to the gateway has no kind that targets an agent gateway.",
      "type": [
        "object",
        "null"
      ]
    },
    "is_google_managed": {
      "type": "boolean"
    },
    "model_armor_config": {
      "description": "Model Armor content authorization. Refused when set: NetworkServicesAuthzExtension has no service field.",
      "type": [
        "object",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "networking_config": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "access_types": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "enum": [
              "PRIVATE",
              "PUBLIC"
            ]
          }
        },
        "connectivity_template_reuse": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "dns_peering_config": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "domains",
            "target_network"
          ],
          "properties": {
            "domains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "target_network": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "labels": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "psc_i_network_attachment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "vpc_egress": {
          "enum": [
            "ALL_TRAFFIC",
            "PRIVATE_RANGES_ONLY",
            null
          ]
        }
      }
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "proxy_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "registries": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    }
  }
}

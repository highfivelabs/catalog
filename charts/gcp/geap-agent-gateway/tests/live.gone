# What the live case makes (hack/live-apply.sh, "A case can also live beside its chart"), children first.
api https://iam.googleapis.com/v3/projects/${PROJECT}/locations/global/policyBindings/${RUN}-ap
api https://iam.googleapis.com/v3/projects/${PROJECT}/locations/global/accessPolicies/${RUN}-ap
api https://networksecurity.googleapis.com/v1/projects/${PROJECT}/locations/${REGION}/authzPolicies/${RUN}-agw-iap
api https://networkservices.googleapis.com/v1/projects/${PROJECT}/locations/${REGION}/authzExtensions/${RUN}-agw-iap
api https://networkservices.googleapis.com/v1/projects/${PROJECT}/locations/${REGION}/agentGateways/${RUN}-agw
api https://networkservices.googleapis.com/v1/projects/${PROJECT}/locations/${REGION}/agentConnectivityTemplates/${RUN}-agw
compute network-attachments describe ${RUN}-agw-na --region ${REGION}
compute networks subnets describe ${RUN}-agw-sn --region ${REGION}
compute networks describe ${RUN}-agw-net

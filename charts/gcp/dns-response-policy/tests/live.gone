# What the live case makes (hack/live-apply.sh, "A case can also live beside its chart").
dns response-policies rules describe pubsub --response-policy ${RUN}-rp
dns response-policies rules describe storage --response-policy ${RUN}-rp
sweep dns response-policies update ${RUN}-rp --networks=
dns response-policies describe ${RUN}-rp
compute networks describe ${RUN}-rp-net

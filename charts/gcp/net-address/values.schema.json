{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "net-address values (fabric net-address v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id"
  ],
  "properties": {
    "names": {
      "description": "net-address gives no singular cloud name: every address, endpoint and attachment is named in its own entry (not Terraform variables; docs/design.md, \"Names, labels and tags\").",
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every address, endpoint and attachment name. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object; an unprefixed key also becomes a Google Cloud label on the resources that take labels.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource that takes them (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "context": {
      "description": "Context-specific interpolations (locations, networks, project_ids, subnets). Refused when set: Bundt's ${...} expressions and valueFrom replace fabric's $context lookups.",
      "type": [
        "object",
        "null"
      ]
    },
    "external_addresses": {
      "description": "Map of external addresses, keyed by name.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "ipv6": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "endpoint_type": {
                "type": "string",
                "enum": [
                  "NETLB",
                  "VM"
                ]
              }
            },
            "required": [
              "endpoint_type"
            ]
          },
          "labels": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          },
          "subnetwork": {
            "type": [
              "string",
              "null"
            ]
          },
          "tier": {
            "enum": [
              "PREMIUM",
              "STANDARD",
              null
            ]
          }
        },
        "required": [
          "region"
        ]
      }
    },
    "global_addresses": {
      "description": "List of global addresses to create.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "ipv6": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          }
        }
      }
    },
    "internal_addresses": {
      "description": "Map of internal addresses to create, keyed by name.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "subnetwork": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "ipv6": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "labels": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "region",
          "subnetwork"
        ]
      }
    },
    "ipsec_interconnect_addresses": {
      "description": "Map of internal addresses used for HPA VPN over Cloud Interconnect.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "prefix_length": {
            "type": "integer"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "required": [
          "address",
          "network",
          "region",
          "prefix_length"
        ]
      }
    },
    "network_attachments": {
      "description": "PSC network attachments, names as keys.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subnet_self_link": {
            "type": "string",
            "pattern": "regions/[^/]+/subnetworks/"
          },
          "automatic_connection": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "producer_accept_lists": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "producer_reject_lists": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "subnet_self_link"
        ]
      }
    },
    "project_id": {
      "description": "Project where the addresses will be created.",
      "type": "string",
      "minLength": 1
    },
    "psa_addresses": {
      "description": "Map of internal addresses used for Private Service Access.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "minLength": 1
          },
          "prefix_length": {
            "type": "integer"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "required": [
          "address",
          "network",
          "prefix_length"
        ]
      }
    },
    "psc_addresses": {
      "description": "Map of internal addresses used for Private Service Connect.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          },
          "network": {
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "subnet_self_link": {
            "type": [
              "string",
              "null"
            ]
          },
          "service_attachment": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "psc_service_attachment_link": {
                "type": "string",
                "minLength": 1
              },
              "global_access": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "service_directory_registration": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "namespace": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "region": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "required": [
              "psc_service_attachment_link"
            ]
          }
        }
      }
    },
    "deletion_policy": {
      "description": "DELETE (default) or ABANDON (not a fabric variable).",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    }
  }
}

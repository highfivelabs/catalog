{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "net-firewall-policy values (fabric net-firewall-policy v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "parent_id"
  ],
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "match"
      ],
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "security_profile_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "tls_inspect": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "action": {
          "enum": [
            "allow",
            "deny",
            "goto_next",
            "apply_security_profile_group",
            null
          ]
        },
        "enable_logging": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "target_resources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "target_service_accounts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "destination_ranges": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "source_ranges": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "source_tags": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "layer4_configs": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "protocol": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ports": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "address_groups": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "fqdns": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "region_codes": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "threat_intelligences": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "mirroringRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "security_profile_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "tls_inspect": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "action": {
          "enum": [
            "mirror",
            "do_not_mirror",
            "goto_next",
            null
          ]
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "destination_ranges": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "source_ranges": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "source_tags": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "layer4_configs": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "protocol": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ports": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "A packet mirroring rule: priority and match are required (the chart checks them once allow_alpha accepts the kind)."
    }
  },
  "properties": {
    "names": {
      "description": "The policy's name in full (not a Terraform variable; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of the derived policy name. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "allow_alpha": {
      "description": "Accept the v1alpha1 kinds a regional policy and packet mirroring rules need (not a fabric variable; docs/design.md, \"Alpha kinds\").",
      "type": [
        "boolean",
        "null"
      ]
    },
    "attachments": {
      "description": "Ids of the resources to which this policy will be attached, in descriptive name => self link format.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "context": {
      "description": "Context-specific interpolations. Refused when set: Bundt's ${...} expressions and valueFrom replace fabric's $context lookups.",
      "type": [
        "object",
        "null"
      ]
    },
    "description": {
      "description": "Policy description.",
      "type": [
        "string",
        "null"
      ]
    },
    "egress_mirroring_rules": {
      "description": "Egress packet mirroring rules.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/mirroringRule"
      }
    },
    "egress_rules": {
      "description": "Egress rules.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/rule"
      }
    },
    "factories_config": {
      "description": "Paths to factory files; accepted and ignored (their contents go under factories_data).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "cidr_file_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "egress_rules_file_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "ingress_rules_file_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "ingress_mirroring_rules_file_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "egress_mirroring_rules_file_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "factories_data": {
      "description": "The factory files' contents (not a Terraform variable).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "cidrs": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "egress_rules": {
          "description": "egress_rules_file_path's rules.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/definitions/rule"
          }
        },
        "ingress_rules": {
          "description": "ingress_rules_file_path's rules.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/definitions/rule"
          }
        },
        "egress_mirroring_rules": {
          "description": "egress_mirroring_rules_file_path's rules.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/definitions/mirroringRule"
          }
        },
        "ingress_mirroring_rules": {
          "description": "ingress_mirroring_rules_file_path's rules.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/definitions/mirroringRule"
          }
        }
      }
    },
    "ingress_mirroring_rules": {
      "description": "Ingress packet mirroring rules.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/mirroringRule"
      }
    },
    "ingress_rules": {
      "description": "Ingress rules.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/rule"
      }
    },
    "name": {
      "description": "Policy name.",
      "type": "string",
      "minLength": 1
    },
    "parent_id": {
      "description": "folders/nnn or organizations/nnn for a hierarchical policy, a project ID for a network policy.",
      "type": "string",
      "minLength": 1
    },
    "region": {
      "description": "Null for a hierarchical policy, global for a global network policy, else a region.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "security_profile_group_ids": {
      "description": "Security profile group IDs rules may name by key.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "tag_bindings": {
      "description": "Tag bindings for this firewall policy, in key => tag value id format.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "deletion_policy": {
      "description": "DELETE (default) or ABANDON (not a fabric variable).",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    }
  }
}

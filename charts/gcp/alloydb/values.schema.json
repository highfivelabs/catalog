{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "alloydb values (fabric alloydb v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cluster_name",
    "instance_name",
    "location",
    "project_id",
    "network_config"
  ],
  "properties": {
    "labels": {
      "description": "Kubernetes labels on every object; an unprefixed key also becomes a Google Cloud label (Config Connector copies it to the clusters' and instances' labels).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every derived cloud name, never one set under names. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "names": {
      "description": "Cloud names set in full (not Terraform variables; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix; one not set derives as fabric derives it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "description": "The primary cluster's ID in full.",
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "instance": {
          "description": "The primary instance's ID in full.",
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "secondaryCluster": {
          "description": "The secondary cluster's ID in full.",
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "secondaryInstance": {
          "description": "The secondary instance's ID in full.",
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        }
      }
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "annotations": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "Annotations for client tools, on the instances."
    },
    "automated_backup_configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "backup_window": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "weekly_schedule": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "days_of_week": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "enum": [
                  "MONDAY",
                  "TUESDAY",
                  "WEDNESDAY",
                  "THURSDAY",
                  "FRIDAY",
                  "SATURDAY",
                  "SUNDAY"
                ]
              }
            },
            "start_times": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "hours"
                ],
                "properties": {
                  "hours": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23
                  }
                }
              }
            }
          }
        },
        "retention_count": {
          "type": [
            "number",
            "null"
          ]
        },
        "retention_period": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "Automated backup settings for cluster."
    },
    "availability_type": {
      "description": "Availability type for the primary replica.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ZONAL",
        "REGIONAL",
        null
      ]
    },
    "client_connection_config": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "require_connectors": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ssl_config": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "ssl_mode": {
              "type": "string"
            }
          },
          "required": [
            "ssl_mode"
          ]
        }
      },
      "description": "Client connection config: refused (AlloyDBInstance has no such field)."
    },
    "cluster_display_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Display name of the primary cluster."
    },
    "cluster_name": {

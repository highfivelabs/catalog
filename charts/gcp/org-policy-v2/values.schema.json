{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "org-policy-v2 values (terraform-google-org-policy modules/org_policy_v2 v7.4.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "constraint",
    "rules"
  ],
  "definitions": {
    "stringSet": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "properties": {
    "names": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Not a Terraform variable. An organization policy is named by its parent and constraint, so this chart gives no cloud name and takes no key here (docs/design.md, \"Names, labels and tags\")."
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable). This chart gives no cloud name, so it changes nothing. A DNS label.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource; organization policies have none, so they stay Kubernetes labels.",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "deletion_policy": {
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ],
      "description": "Not a module variable. PREVENT is refused (no Config Connector equivalent)."
    },
    "policy_root": {
      "description": "policy_root should be one of organization, folder, or project",
      "enum": [
        "organization",
        "folder",
        "project"
      ]
    },
    "policy_root_id": {
      "description": "The policy root id, either of organization_id, folder_id or project_id. Needed.",
      "type": [
        "string",
        "null"
      ]
    },
    "exclude_folders": {
      "$ref": "#/definitions/stringSet"
    },
    "exclude_projects": {
      "$ref": "#/definitions/stringSet"
    },
    "constraint": {
      "description": "Required. The constraint, without the constraints/ prefix.",
      "type": "string",
      "minLength": 1
    },
    "policy_type": {
      "description": "boolean or list. The module renders nothing for any other value; the chart refuses one.",
      "enum": [
        "boolean",
        "list"
      ]
    },
    "inherit_from_parent": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enforcement"
        ],
        "properties": {
          "enforcement": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "dry_run": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "parameters": {
            "description": "The managed constraint's parameters as a JSON object (Terraform: jsonencode({...})).",
            "type": [
              "string",
              "null"
            ]
          },
          "allow": {
            "$ref": "#/definitions/stringSet"
          },
          "deny": {
            "$ref": "#/definitions/stringSet"
          },
          "conditions": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "expression",
                "title",
                "location"
              ],
              "properties": {
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "expression": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "location": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}

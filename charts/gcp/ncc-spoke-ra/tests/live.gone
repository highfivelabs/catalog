# What the live case makes (hack/live-apply.sh, "A case can also live beside its chart"), children first.
network-connectivity spokes describe ${RUN}-spoke --region ${REGION}
compute routers describe ${RUN}-spoke-cr --region ${REGION}
network-connectivity hubs describe ${RUN}-hub
compute instances describe ${RUN}-ra --zone ${REGION}-a
compute networks subnets describe ${RUN}-ra-sn --region ${REGION}
compute networks describe ${RUN}-ra-net

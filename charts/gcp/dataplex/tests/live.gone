# What the live case makes (hack/live-apply.sh, "A case can also live beside its chart").
dataplex assets describe landing --lake ${RUN}-lake --zone raw --location ${REGION}
dataplex zones describe raw --lake ${RUN}-lake --location ${REGION}
dataplex lakes describe ${RUN}-lake --location ${REGION}
storage buckets describe gs://${PROJECT}-${RUN}-dpx ;; storage rm -r gs://${PROJECT}-${RUN}-dpx

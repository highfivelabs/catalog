{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "net-vpc-firewall values (fabric net-vpc-firewall v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "network",
    "project_id"
  ],
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deny": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "destination_ranges": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "disabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "enable_logging": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "include_metadata": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_ranges": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "use_service_accounts": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rules": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol"
            ],
            "properties": {
              "protocol": {
                "type": "string"
              },
              "ports": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "names": {
      "description": "Default rules' names in full (not Terraform variables; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admins": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "http": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "https": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "ssh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every rule name the chart derives, never one set under names. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "context": {
      "description": "fabric's context interpolations; refused when set.",
      "type": [
        "object",
        "null"
      ]
    },
    "default_rules_config": {
      "description": "Optionally created convenience rules.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admin_ranges": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "disabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "http_ranges": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "http_tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "https_ranges": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "https_tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "ssh_ranges": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "ssh_tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "egress_rules": {
      "description": "Egress rule definitions, default to deny action.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/rule"
      }
    },
    "factories_config": {
      "description": "Paths to factory files; accepted and ignored (their contents go under factories_data).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "cidr_tpl_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules_folder": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "factories_data": {
      "description": "The factory files' contents (not a Terraform variable).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "$ref": "#/definitions/rule"
              }
            }
          }
        },
        "cidr_tpl": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "ingress_rules": {
      "description": "Ingress rule definitions, default to allow action.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/rule"
      }
    },
    "named_ranges": {
      "description": "Names of ranges usable in rules.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "network": {
      "description": "Name (or self link) of the network.",
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "description": "Project id of the project that holds the network.",
      "type": "string",
      "minLength": 1
    },
    "deletion_policy": {
      "description": "DELETE (default) or ABANDON (not a fabric variable).",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bigquery-dataset values (fabric bigquery-dataset v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_id"
  ],
  "definitions": {
    "condition": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "expression",
        "title"
      ]
    }
  },
  "properties": {
    "names": {
      "description": "Cloud names in full (not a Terraform variable; docs/design.md, \"Names, labels and tags\"): dataset. A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_]+$"
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>_ (its hyphens as underscores) in front of the dataset's ID when names.dataset is not set. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "fabric's dataset labels, with the catalog's meaning: labels on every object (an unprefixed one is a cloud label too).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every object (lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "allow_alpha": {
      "description": "Accept v1alpha1 kinds: BigQueryDatasetAccess (access, authorized_views and authorized_datasets with dataset_access: false) and config-connector-extensions' IAMMember (iam_bindings_additive). Not a Terraform variable.",
      "type": "boolean"
    },
    "deletion_policy": {
      "description": "DELETE (default) or ABANDON (not a fabric variable).",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },

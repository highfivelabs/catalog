# What the live case makes (hack/live-apply.sh, "A case can also live beside its chart"), children first.
api-gateway gateways describe gw-${RUN}-a --location ${REGION}
sweep-sh gcloud --quiet --project ${PROJECT} api-gateway api-configs list --api ${RUN}-a --format='value(name.basename())' | while read -r c; do gcloud --quiet --project ${PROJECT} api-gateway api-configs delete "\$c" --api ${RUN}-a && echo "swept api config \$c"; done
sh gcloud --quiet --project ${PROJECT} api-gateway api-configs list --api ${RUN}-a --format='value(name)' | grep -q .
api-gateway apis describe ${RUN}-a
iam service-accounts describe sa-api-cfg-${RUN}-a@${PROJECT}.iam.gserviceaccount.com

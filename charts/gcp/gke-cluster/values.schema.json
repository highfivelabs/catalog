{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gke-cluster values (terraform-google-kubernetes-engine beta-private-cluster and beta-autopilot-private-cluster v47.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "project_id",
    "network",
    "subnetwork",
    "ip_range_pods"
  ],
  "definitions": {
    "stringList": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "stringMap": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "boolish": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "intish": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "numish": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^-?[0-9.]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "properties": {
    "mode": {
      "enum": [
        "standard",
        "autopilot"
      ],
      "description": "standard (beta-private-cluster) or autopilot (beta-autopilot-private-cluster). Not a module variable."
    },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "description": "Collision-prone cloud names set in full (not Terraform variables; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix; one not set derives from name.",
      "properties": {
        "cluster": {
          "type": "string",
          "maxLength": 40
        },
        "serviceAccount": {
          "type": "string",
          "maxLength": 30
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every derived cloud name, never one set under names. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object; an unprefixed key also becomes a Google Cloud label (Config Connector copies it).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "deletion_policy": {
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",

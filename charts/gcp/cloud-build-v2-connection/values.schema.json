{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cloud-build-v2-connection values (fabric cloud-build-v2-connection v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "location",
    "name"
  ],
  "definitions": {
    "condition": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "expression",
        "title"
      ],
      "properties": {
        "expression": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "names": {
      "description": "The connection's ID in full (not a Terraform variable; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of the connection's ID (unless set under names) and every repository's. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object; none of these resources takes Google Cloud labels.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels (Google Cloud labels: lower-case letters, digits, _ and -); none of these resources takes them, so they stay on metadata.labels.",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "annotations": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "Annotations."
    },
    "connection_config": {
      "description": "Connection configuration. Exactly one of its keys must be set (a template check, with fabric's message).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "bitbucket_cloud": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "app_installation_id": {
              "description": "A GitHub App installation ID (a number; fabric types it as a string).",
              "type": [
                "string",
                "integer",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "authorizer_credential_secret_version": {
              "type": "string"
            },
            "read_authorizer_credential_secret_version": {
              "type": "string"
            },
            "webhook_secret_secret_version": {
              "type": "string"
            },
            "workspace": {
              "type": "string"
            }
          },
          "required": [
            "authorizer_credential_secret_version",
            "read_authorizer_credential_secret_version",
            "webhook_secret_secret_version",
            "workspace"
          ]
        },
        "bitbucket_data_center": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "authorizer_credential_secret_version": {
              "type": "string"
            },
            "host_uri": {
              "type": "string"
            },
            "read_authorizer_credential_secret_version": {
              "type": "string"
            },
            "service": {
              "type": [
                "string",
                "null"
              ]
            },
            "ssl_ca": {
              "type": [
                "string",
                "null"
              ]
            },
            "webhook_secret_secret_version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "authorizer_credential_secret_version",
            "host_uri",
            "read_authorizer_credential_secret_version"
          ]
        },
        "github": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "app_installation_id": {
              "description": "A GitHub App installation ID (a number; fabric types it as a string).",
              "type": [
                "string",
                "integer",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "authorizer_credential_secret_version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "github_enterprise": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "app_id": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            },
            "app_installation_id": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            },
            "app_slug": {
              "type": [
                "string",
                "null"
              ]
            },
            "host_uri": {
              "type": "string"
            },
            "private_key_secret_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "service": {
              "type": [
                "string",
                "null"
              ]
            },
            "ssl_ca": {
              "type": [
                "string",
                "null"
              ]
            },
            "webhook_secret_secret_version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "host_uri"
          ]
        },
        "gitlab": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "host_uri": {
              "type": [
                "string",
                "null"
              ]
            },
            "webhook_secret_secret_version": {
              "type": "string"
            },
            "read_authorizer_credential_secret_version": {
              "type": "string"
            },
            "authorizer_credential_secret_version": {
              "type": "string"
            },
            "service": {
              "type": [
                "string",
                "null"
              ]
            },
            "ssl_ca": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "webhook_secret_secret_version",
            "read_authorizer_credential_secret_version",
            "authorizer_credential_secret_version"
          ]
        }
      }
    },
    "connection_create": {
      "description": "Create connection.",
      "type": "boolean"
    },
    "context": {
      "description": "Context-specific interpolations (custom_roles, iam_principals, locations, project_ids). Refused when set (use Bundt expressions).",
      "type": [
        "object",
        "null"
      ]
    },
    "disabled": {
      "description": "Flag indicating whether the connection is disabled or not.",
      "type": "boolean"
    },
    "iam": {
      "description": "IAM bindings in {ROLE => [MEMBERS]} format.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_bindings": {
      "description": "Authoritative IAM bindings in {KEY => {role = ROLE, members = [], condition = {}}}. Keys are arbitrary. The condition is accepted and not sent, as fabric does.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "members",
          "role"
        ],
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "$ref": "#/definitions/condition"
          }
        }
      }
    },
    "iam_bindings_additive": {
      "description": "Individual additive IAM bindings. Keys are arbitrary. IAMMember is v1alpha1: needs allow_alpha. The condition is accepted and not sent, as fabric does.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member",
          "role"
        ],
        "properties": {
          "member": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "$ref": "#/definitions/condition"
          }
        }
      }
    },
    "iam_by_principals": {
      "description": "Authoritative IAM binding in {PRINCIPAL => [ROLES]} format. Merged internally with the iam variable.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "location": {
      "description": "Location.",
      "type": "string",
      "minLength": 1
    },
    "name": {
      "description": "Name.",
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "description": "Project ID.",
      "type": "string",
      "minLength": 1
    },
    "repositories": {
      "description": "Repositories. CloudBuildRepository is v1alpha1: needs allow_alpha.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "remote_uri"
        ],
        "properties": {
          "remote_uri": {
            "type": "string"
          },
          "annotations": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "triggers": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "filename"
              ],
              "properties": {
                "approval_required": {
                  "description": "Accepted and not sent, as fabric does.",
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pull_request": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "branch": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "invert_regex": {
                      "type": [
                        "string",
                        "boolean",
                        "null"
                      ]
                    },
                    "comment_control": {
                      "enum": [
                        "COMMENTS_DISABLED",
                        "COMMENTS_ENABLED",
                        "COMMENTS_ENABLED_FOR_EXTERNAL_CONTRIBUTORS_ONLY",
                        null
                      ]
                    }
                  }
                },
                "push": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "branch": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "invert_regex": {
                      "type": [
                        "string",
                        "boolean",
                        "null"
                      ]
                    },
                    "tag": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "disabled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "filename": {
                  "type": "string"
                },
                "include_build_logs": {
                  "enum": [
                    "INCLUDE_BUILD_LOGS_UNSPECIFIED",
                    "INCLUDE_BUILD_LOGS_WITH_STATUS",
                    null
                  ]
                },
                "substitutions": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "service_account": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tags": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "allow_alpha": {
      "description": "Accept v1alpha1 kinds (CloudBuildRepository, for repositories and their triggers; IAMMember, for iam_bindings_additive). Not a Terraform variable.",
      "type": "boolean"
    },
    "deletion_policy": {
      "description": "DELETE (default) or ABANDON (not a fabric variable).",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    }
  }
}

      ]
    },
    "taints": {
      "description": "Kubernetes taints applied to all nodes.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string"
          },
          "effect": {
            "description": "Invalid taint effect.",
            "enum": [
              "NO_SCHEDULE",
              "PREFER_NO_SCHEDULE",
              "NO_EXECUTE"
            ]
          }
        },
        "required": [
          "value",
          "effect"
        ]

        "current": {
          "type": [
            "integer",
            "null"
          ]
        },
        "initial": {
          "type": "integer"
        }
      },
      "required": [
        "initial"
      ]
    },
    "node_locations": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "nodepool_config": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "autoscaling": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "location_policy": {
              "type": [
                "string",
                "null"
              ]
            },
            "max_node_count": {
              "type": [
                "integer",
                "null"
              ]
            },
            "min_node_count": {
              "type": [
                "integer",
                "null"
              ]
            },
            "use_total_nodes": {
              "type": [

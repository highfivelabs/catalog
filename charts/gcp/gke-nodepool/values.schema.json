              "type": [
                "string",
                "null"
              ]
            },
            "blue_green_settings": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "node_pool_soak_duration": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "standard_rollout_policy": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "batch_percentage": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "batch_node_count": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "batch_soak_duration": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "required": [

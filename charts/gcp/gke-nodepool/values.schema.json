{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gke-nodepool values (fabric gke-nodepool v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cluster_name",
    "location",
    "project_id"
  ],
  "properties": {
    "names": {
      "description": "Cloud names in full (not Terraform variables; docs/design.md, \"Names, labels and tags\"): nodepool, serviceAccount. A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodepool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "serviceAccount": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])$"
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of the derived node pool name and service account ID, never a name set under names. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "fabric's labels: resource labels on each node, and Kubernetes labels on every object (a prefixed key stays in Kubernetes).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "fabric's network tags (a list), or, as every chart's tags, cloud labels (a map) on the nodes and every object.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
          }
        }
      ]
    },
    "cluster_id": {
      "description": "Cluster id.",
      "type": [
        "string",
        "null"
      ]
    },
    "cluster_name": {
      "description": "Cluster name.",
      "type": "string",
      "minLength": 1
    },
    "gke_version": {
      "description": "Kubernetes nodes version.",
      "type": [
        "string",
        "null"
      ]
    },
    "k8s_labels": {
      "description": "Kubernetes labels applied to each node.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "location": {
      "description": "Cluster location.",
      "type": "string",
      "minLength": 1
    },
    "max_pods_per_node": {
      "description": "Maximum number of pods per node.",
      "type": [
        "integer",
        "null"
      ]
    },
    "name": {
      "description": "Optional nodepool name.",
      "type": [
        "string",
        "null"
      ]
    },
    "network_config": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "enable_private_nodes": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pod_range": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "cidr": {
              "type": [
                "string",
                "null"
              ]
            },
            "create": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "additional_node_network_configs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "network": {
                "type": "string"
              },
              "subnetwork": {
                "type": "string"
              }
            },
            "required": [
              "network",
              "subnetwork"
            ]
          }
        },
        "additional_pod_network_configs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subnetwork": {
                "type": "string"
              },
              "secondary_pod_range": {
                "type": "string"
              },
              "max_pods_per_node": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "required": [
              "subnetwork",
              "secondary_pod_range",
              "max_pods_per_node"
            ]
          }
        },
        "total_egress_bandwidth_tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "pod_cidr_overprovisioning_disabled": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "node_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boot_disk": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "kms_key": {
              "type": [
                "string",
                "null"
              ]
            },
            "size_gb": {
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "provisioned_iops": {
              "type": [
                "number",
                "null"
              ]
            },
            "provisioned_throughput": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "boot_disk_kms_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "disk_size_gb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "disk_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "ephemeral_ssd_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ephemeral_storage_local_ssd_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "gcfs": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "guest_accelerator": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer"
            },
            "type": {
              "type": "string"
            },
            "gpu_driver": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "version": {
                  "description": "Invalid GPU driver version.",
                  "enum": [
                    "GPU_DRIVER_VERSION_UNSPECIFIED",
                    "INSTALLATION_DISABLED",
                    "DEFAULT",
                    "LATEST"
                  ]
                },
                "partition_size": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "max_shared_clients_per_gpu": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "version"
              ]
            }
          },
          "required": [
            "count",
            "type"
          ]
        },
        "local_nvme_ssd_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "gvnic": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "image_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "kubelet_config": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu_manager_policy": {
              "type": "string"
            },
            "cpu_cfs_quota": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "cpu_cfs_quota_period": {
              "type": [
                "string",
                "null"
              ]
            },
            "insecure_kubelet_readonly_port_enabled": {
              "type": [
                "string",
                "null"
              ]
            },
            "pod_pids_limit": {
              "type": [
                "integer",
                "null"
              ]
            },
            "container_log_max_size": {
              "type": [
                "string",
                "null"
              ]
            },
            "container_log_max_files": {
              "type": [
                "integer",
                "null"
              ]
            },
            "image_gc_low_threshold_percent": {
              "type": [
                "integer",
                "null"
              ]
            },
            "image_gc_high_threshold_percent": {
              "type": [
                "integer",
                "null"
              ]
            },
            "image_minimum_gc_age": {
              "type": [
                "string",
                "null"
              ]
            },
            "image_maximum_gc_age": {
              "type": [
                "string",
                "null"
              ]
            },
            "allowed_unsafe_sysctls": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "cpu_manager_policy"
          ]
        },
        "linux_node_config": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "sysctls": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "string"
              }
            },
            "cgroup_mode": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "local_ssd_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "machine_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "min_cpu_platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "preemptible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sandbox_config_gvisor": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "shielded_instance_config": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "enable_integrity_monitoring": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "enable_secure_boot": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "spot": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "flex_start": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "workload_metadata_config_mode": {
          "description": "node_config.workload_metadata_config_mode must be GCE_METADATA or GKE_METADATA.",
          "enum": [
            "GCE_METADATA",
            "GKE_METADATA",
            null
          ]
        },
        "advanced_machine_features": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "enable_nested_virtualization": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "threads_per_core": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "containerd_config": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "private_registry_access_config": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "certificate_authority_domain_config": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "fqdns": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "gcp_secret_manager_certificate_config_secret_uri": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "fqdns",
                      "gcp_secret_manager_certificate_config_secret_uri"
                    ]
                  }
                }
              }
            },
            "writable_cgroups": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "registry_hosts": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "hosts": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "capabilities": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": "string"
                          }
                        },
                        "override_path": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "dial_timeout": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "header": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "ca_gcp_secret_manager_secret_uri": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "client": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "cert_gcp_secret_manager_secret_uri": {
                              "type": "string"
                            },
                            "key_gcp_secret_manager_secret_uri": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "cert_gcp_secret_manager_secret_uri"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "Node-level configuration."
    },
    "node_count": {
      "type": "object",
      "additionalProperties": false,

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "biglake-catalog values (fabric biglake-catalog v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["databases", "location", "name", "project_id"],
  "properties": {
    "names": {
      "description": "Cloud names in full (not a Terraform variable; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog": {"type": "string", "minLength": 1, "maxLength": 63}
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of the catalog's name when names.catalog is not set. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object.",
      "type": ["object", "null"],
      "additionalProperties": {"type": "string", "maxLength": 63}
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": ["object", "null"],
      "propertyNames": {"pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"},
      "additionalProperties": {"type": "string", "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"}
    },
    "databases": {
      "description": "Databases.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "hive_options", "tables"],
        "properties": {
          "type": {"type": "string"},
          "hive_options": {
            "type": "object",
            "additionalProperties": false,
            "required": ["location_uri"],
            "properties": {
              "location_uri": {"type": "string"},
              "parameters": {"type": ["object", "null"], "additionalProperties": {"type": "string"}}
            }
          },
          "tables": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "hive_options"],
              "properties": {
                "type": {"type": "string"},
                "hive_options": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["table_type", "location_uri", "input_format", "output_format"],
                  "properties": {
                    "table_type": {"type": "string"},
                    "location_uri": {"type": "string"},
                    "input_format": {"type": "string"},
                    "output_format": {"type": "string"},
                    "parameters": {"type": ["object", "null"], "additionalProperties": {"type": "string"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "location": {"description": "Location.", "type": "string", "minLength": 1},
    "name": {"description": "Name.", "type": "string", "minLength": 1},
    "project_id": {"description": "Project ID.", "type": "string", "minLength": 1},
    "deletion_policy": {
      "description": "DELETE (default) or ABANDON (not a fabric variable).",
      "enum": ["DELETE", "ABANDON", "PREVENT", null]
    }
  }
}

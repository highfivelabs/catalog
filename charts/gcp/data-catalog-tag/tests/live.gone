# What the live case makes (hack/live-apply.sh, "A case can also live beside its chart").
# The tags go with their dataset; the template is checked, and swept with force.
api https://bigquery.googleapis.com/bigquery/v2/projects/${PROJECT}/datasets/${RUN_}_dct ;; api https://bigquery.googleapis.com/bigquery/v2/projects/${PROJECT}/datasets/${RUN_}_dct?deleteContents=true
api https://datacatalog.googleapis.com/v1/projects/${PROJECT}/locations/${REGION}/tagTemplates/${RUN_}_tt ;; api https://datacatalog.googleapis.com/v1/projects/${PROJECT}/locations/${REGION}/tagTemplates/${RUN_}_tt?force=true

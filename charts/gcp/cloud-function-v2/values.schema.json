{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cloud-function-v2 values (fabric cloud-function-v2 v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bucket_name",
    "bundle_config",
    "name",
    "project_id",
    "region"
  ],
  "properties": {
    "deletion_policy": {
      "description": "DELETE (default) or ABANDON (not a fabric variable).",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "labels": {
      "description": "Kubernetes labels on every object; an unprefixed key also becomes a Google Cloud label. fabric's labels.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every derived name, never a name set under names. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "names": {
      "description": "Cloud names in full (not Terraform variables; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "function": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z][-a-z0-9]*[a-z0-9]$"
        },
        "bucket": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z0-9][-a-z0-9_.]*[a-z0-9]$"
        },
        "serviceAccount": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])$"
        },
        "triggerServiceAccount": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])$"
        },
        "vpcConnector": {
          "type": "string",
          "minLength": 2,
          "maxLength": 25,
          "pattern": "^[a-z][-a-z0-9]*[a-z0-9]$"
        }
      }
    },
    "tags": {
      "description": "Cloud labels on every resource (Google Cloud labels: lower-case letters, digits, _ and -).",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
      }
    },
    "bucket_config": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "force_destroy": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "lifecycle_delete_age_days": {
          "type": [
            "number",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "Enable and configure auto-created bucket. Set fields to null to use defaults."
    },
    "bucket_name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the bucket that will be used for the function code. It will be created with prefix prepended if bucket_config is not null."
    },
    "build_environment_variables": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "A set of key/value environment variable pairs available during build time."
    },
    "build_service_account": {
      "type": [
        "string",
        "null"
      ],
      "description": "Build service account email."
    },
    "build_worker_pool": {
      "type": [
        "string",
        "null"
      ],
      "description": "Build worker pool, in projects/<PROJECT-ID>/locations/<REGION>/workerPools/<POOL_NAME> format."
    },
    "bundle_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "folder_options": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "archive_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "excludes": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "path"
      ],
      "description": "Cloud function source: a Cloud Storage object URI (gs://.../*.zip). A local zip or folder, and folder_options, are refused."
    },
    "context": {
      "description": "fabric's context interpolations; refused when set.",
      "type": [
        "object",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional description."
    },
    "direct_vpc_egress": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "VPC_EGRESS_ALL_TRAFFIC",
            "VPC_EGRESS_PRIVATE_RANGES_ONLY"
          ]
        },
        "network": {
          "type": "string"
        },
        "subnetwork": {
          "type": "string"
        },
        "tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode",
        "network",
        "subnetwork"
      ],
      "description": "Direct VPC egress configuration."
    },
    "docker_repository_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "User managed repository created in Artifact Registry."
    },
    "environment_variables": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "Cloud function environment variables."
    },
    "function_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automatic_update_policy": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "binary_authorization_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "entry_point": {
          "type": [
            "string",
            "null"
          ]
        },
        "instance_count": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_instance_request_concurrency": {
          "type": [
            "number",
            "null"
          ]
        },
        "min_instance_count": {
          "type": [
            "number",
            "null"
          ]
        },
        "memory_mb": {
          "type": [
            "number",
            "null"
          ]
        },
        "on_deploy_update_policy": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "description": "Cloud function configuration."
    },
    "iam": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "IAM bindings in {ROLE => [MEMBERS]} format."
    },
    "ingress_settings": {
      "enum": [
        "ALLOW_ALL",
        "ALLOW_INTERNAL_AND_GCLB",
        "ALLOW_INTERNAL_ONLY",
        null
      ],
      "description": "Control traffic that reaches the cloud function."
    },
    "kms_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Resource name of a KMS crypto key used to encrypt/decrypt function resources in key id format."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Name used for cloud function and associated resources."
    },
    "prefix": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Optional prefix used for resource names. Prefix cannot be empty, please use null instead."
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "description": "Project id used for all resources."
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "description": "Region used for all resources."
    },
    "secrets": {
      "type": [
        "object",
        "null"
      ],
      "description": "Secret Manager secrets. Key is the variable name or mountpoint, volume versions are in version:path format.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "is_volume": {
            "type": "boolean"
          },
          "project_id": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "is_volume",
          "project_id",
          "secret",
          "versions"
        ]
      }
    },
    "service_account_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "roles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Service account configurations."
    },
    "trigger_config": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "type": "string"
        },
        "pubsub_topic": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_filters": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attribute": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "operator": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "attribute",
              "value"
            ]
          }
        },
        "service_account_email": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_account_create": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "retry_policy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "event_type"
      ],
      "description": "Function trigger configuration. Leave null for HTTP trigger."
    },
    "vpc_connector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "egress_settings": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "VPC connector configuration."
    },
    "vpc_connector_create": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "ip_cidr_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "machine_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "network": {
          "type": [
            "string",
            "null"
          ]
        },
        "instances": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "max": {
              "type": [
                "number",
                "null"
              ]
            },
            "min": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "throughput": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "max": {
              "type": [
                "number",
                "null"
              ]
            },
            "min": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "subnet": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "project_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "description": "VPC connector network configuration. Must be provided if new VPC connector is being created."
    }
  }
}

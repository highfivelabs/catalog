# What the live case makes (hack/live-apply.sh, "A case can also live beside its chart").
functions describe ${RUN}-cf --region ${REGION} --gen2
run services describe ${RUN}-cf --region ${REGION}
iam service-accounts describe ${RUN}-cf@${PROJECT}.iam.gserviceaccount.com
# The bundle's bucket, which live.pre.sh made: the sweeper's.
sweep storage rm -r gs://${PROJECT}-${RUN}-cf

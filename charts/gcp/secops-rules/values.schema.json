{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "secops-rules values (fabric secops-rules v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "names": {
      "description": "Not used: the chart derives no names (not a Terraform variable).",
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable); nothing in this chart takes it. A DNS label.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "tags": {
      "description": "Cloud labels; nothing in this chart takes them.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "allow_alpha": {
      "description": "Accept config-connector-extensions' v1alpha1 ChronicleRuleDeployment, which rules_config needs (not a Terraform variable).",
      "type": "boolean"
    },
    "deletion_policy": {
      "description": "DELETE or ABANDON (not a Terraform variable).",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "factories_config": {
      "description": "Paths to the rules and reference lists YAML (refused: put their content in rules_config and reference_lists_config) and the folders of their definitions (whose files go in factories_data).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules_defs": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_lists": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_lists_defs": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "factories_data": {
      "description": "The files of factories_config's folders (not a Terraform variable): rules {RULE => YARA-L text}, reference_lists {LIST => text, one entry per line, or a list of entries}.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "reference_lists": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "project_id": {
      "description": "Project used for resources.",
      "type": "string"
    },
    "reference_lists_config": {
      "description": "SecOps Reference lists configuration.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "type"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "rules_config": {
      "description": "SecOps Detection rules configuration.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "alerting": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "archived": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "run_frequency": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tenant_config": {
      "description": "SecOps Tenant configuration.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "customer_id",
        "region"
      ],
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      }
    }
  }
}

# What the live case makes (hack/live-apply.sh, "A case can also live beside its chart"), children first.
api https://backupdr.googleapis.com/v1/projects/${PROJECT}/locations/${REGION}/managementServers/${RUN}-ms
api https://backupdr.googleapis.com/v1/projects/${PROJECT}/locations/${REGION}/backupPlans/${RUN}-plan
api https://backupdr.googleapis.com/v1/projects/${PROJECT}/locations/${REGION}/backupVaults/${RUN}-vault ;; api https://backupdr.googleapis.com/v1/projects/${PROJECT}/locations/${REGION}/backupVaults/${RUN}-vault?force=true

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "avm-ptn-alz values (Azure Verified Module v0.22.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location",
    "parent_resource_id",
    "architecture_name"
  ],
  "properties": {
    "architecture": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "management_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "display_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parent_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "exists": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "level": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "policy_definitions": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": [
                    "string",
                    "object"
                  ]
                }
              },
              "policy_set_definitions": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": [
                    "string",
                    "object"
                  ]
                }
              },
              "policy_assignments": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": [
                    "string",
                    "object"
                  ]
                }
              },
              "role_definitions": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": [
                    "string",
                    "object"
                  ]
                }
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "policy_role_assignments": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "management_group_id": {
                "type": "string"
              },
              "policy_assignment_name": {
                "type": "string"
              },
              "role_definition_id": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              }
            },
            "required": [
              "management_group_id",
              "policy_assignment_name",
              "role_definition_id",
              "scope"
            ]
          }
        }
      },
      "description": "The alz_architecture data source's result (not a Terraform variable)."
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "The tenant's ID (not a Terraform variable): the tenant root management group's name."
    },
    "names": {
      "description": "Names in full (not a Terraform variable). This chart takes none: any key is refused.",
      "type": [
        "object",
        "null"
      ]
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "description": "Azure tags (not a Terraform variable): refused when set."
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "architecture_name": {
      "type": "string",
      "description": "The name of the architecture to create (must equal architecture.name)."
    },
    "delays": {
      "type": [
        "object",
        "null"
      ],
      "description": "DEPRECATED: delays. Accepted with no effect."
    },
    "enable_telemetry": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "This variable controls whether or not telemetry is enabled for the module. The chart never sends telemetry."
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "The default location for resources in this management group. Used for policy managed identities."
    },
    "management_group_hierarchy_settings": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "default_management_group_name": {
          "type": "string"
        },
        "require_authorization_for_group_creation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "update_existing": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "default_management_group_name"
      ],
      "description": "Set this value to configure the hierarchy settings."
    },
    "management_group_role_assignments": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "management_group_name": {
            "type": "string"
          },
          "role_definition_id_or_name": {
            "type": "string"
          },
          "principal_id": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "skip_service_principal_aad_check": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "delegated_managed_identity_resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "principal_type": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "management_group_name",
          "role_definition_id_or_name",
          "principal_id"
        ]
      },
      "description": "A map of role assignments to create."
    },
    "management_groups_dependencies": {
      "description": "Ordering hints. Accepted with no effect."
    },
    "override_policy_definition_parameter_assign_permissions_set": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      },
      "description": "Refused when set."
    },
    "override_policy_definition_parameter_assign_permissions_unset": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      },
      "description": "Refused when set."
    },
    "parent_id_overrides": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "policy_assignments": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "policy_definitions": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "policy_set_definitions": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "role_definitions": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "description": "Parent ID casing overrides. Accepted with no effect."
    },
    "parent_resource_id": {
      "type": "string",
      "description": "The resource name of the parent management group."
    },
    "policy_assignment_non_compliance_message_settings": {
      "type": [
        "object",
        "null"
      ],
      "description": "Refused when set."
    },
    "policy_assignments_dependencies": {
      "description": "Ordering hints. Accepted with no effect."
    },
    "policy_assignments_to_modify": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "policy_assignments": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "creation_enabled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "role_assignments_enabled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "description": "A map of policy assignment objects to modify the ALZ architecture with."
    },
    "policy_default_values": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "Refused when set."
    },
    "policy_role_assignments_dependencies": {
      "description": "Ordering hints. Accepted with no effect."
    },
    "resource_types": {
      "type": [
        "object",
        "null"
      ],
      "description": "Refused when set."
    },
    "retries": {
      "type": [
        "object",
        "null"
      ],
      "description": "Refused when set."
    },
    "role_assignment_definition_lookup_enabled": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "A control to disable the lookup of role definitions when creating role assignments."
    },
    "role_assignment_name_use_random_uuid": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "A control to use a random UUID for the role assignment name."
    },
    "schema_validation_enabled": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "description": "false is refused."
    },
    "subscription_placement": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subscription_id": {
            "type": "string"
          },
          "management_group_name": {
            "type": "string"
          }
        },
        "required": [
          "subscription_id",
          "management_group_name"
        ]
      },
      "description": "A map of subscriptions to place into management groups."
    },
    "subscription_placement_destroy_behavior": {
      "type": "string",
      "enum": [
        "parent",
        "intermediate_root",
        "custom",
        "default"
      ],
      "description": "The behavior to apply when destroying a subscription placement."
    },
    "subscription_placement_destroy_custom_target_management_group_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Refused when set."
    },
    "telemetry_additional_content": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "Accepted; the chart never sends telemetry."
    },
    "timeouts": {
      "type": [
        "object",
        "null"
      ],
      "description": "Refused when set."
    }
  }
}

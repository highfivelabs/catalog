{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "avm-res-insights-component values (Azure Verified Module v0.5.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "location",
    "parent_id",
    "workspace_id"
  ],
  "properties": {
    "names": {
      "description": "The component's name in full (not a Terraform variable). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._()-]{0,254}[A-Za-z0-9_()-]$",
          "maxLength": 255
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._()-]{0,254}[A-Za-z0-9_()-]$"
    },
    "parent_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "application_type": {
      "type": "string",
      "enum": [
        "ios",
        "java",
        "MobileCenter",
        "Node.JS",
        "other",
        "phone",
        "store",
        "web"
      ]
    },
    "daily_data_cap_in_gb": {
      "type": "number",
      "minimum": 0
    },
    "daily_data_cap_notifications_disabled": {
      "type": "boolean"
    },
    "disable_ip_masking": {
      "type": "boolean"
    },
    "force_customer_storage_for_profiler": {
      "type": "boolean"
    },
    "internet_ingestion_enabled": {
      "type": "boolean"
    },
    "internet_query_enabled": {
      "type": "boolean"
    },
    "local_authentication_disabled": {
      "type": "boolean"
    },
    "retention_in_days": {
      "type": "integer",
      "enum": [
        30,
        60,
        90,
        120,
        180,
        270,
        365,
        550,
        730
      ]
    },
    "sampling_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "linked_storage_account": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "monitor_private_link_scope": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Resource",
              "Metrics",
              null
            ]

            "type": [
              "string",
              "null"
            ]
          },
          "logs": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "category": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "category_group": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "enabled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "retention_policy": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "days": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "enabled": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "metrics": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "category": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "enabled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "retention_policy": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "days": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "enabled": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "log_analytics_destination_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Dedicated",
              "AzureDiagnostics",
              null
            ]
          },
          "workspace_resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "storage_account_resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_hub_authorization_rule_resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_hub_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "marketplace_partner_resource_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "enable_telemetry": {
      "type": "boolean"
    },
    "lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CanNotDelete",
            "ReadOnly"
          ]
        },
        "name": {
          "type": [
            "string",

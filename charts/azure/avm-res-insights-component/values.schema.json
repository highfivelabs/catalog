            "type": "string"
          },
          "principal_id": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "skip_service_principal_aad_check": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "delegated_managed_identity_resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "principal_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "User",
              "Group",
              "ServicePrincipal",
              "ForeignGroup",
              "Device",
              null
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "ignore_body_changes": {
      "type": [
        "object",
        "null"
      ]
    },
    "resource_types": {
      "type": [
        "object",
        "null"
      ]
    },
    "retry": {
      "type": [
        "object",
        "null"
      ]
    },
    "timeouts": {

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "avm-res-containerregistry-registry values (Azure Verified Module v0.9.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "location",
    "resource_group_name"
  ],
  "definitions": {
    "roleAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_definition_id_or_name",
        "principal_id"
      ],
      "properties": {
        "role_definition_id_or_name": {
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "skip_service_principal_aad_check": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegated_managed_identity_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "User",
            "Group",
            "ServicePrincipal",
            "ForeignGroup",
            "Device",
            null
          ]
        }
      }
    },
    "diagnosticSetting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "log_categories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "log_groups": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "metric_categories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "log_analytics_destination_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Dedicated",
            "AzureDiagnostics",
            null
          ]
        },
        "workspace_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "storage_account_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hub_authorization_rule_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hub_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "marketplace_partner_resource_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "names": {
      "description": "The registry's name in full (not a Terraform variable). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]{5,50}$",
          "maxLength": 50
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "subscription_id": {
      "description": "The subscription of resource_group_name (not a Terraform variable).",
      "type": [
        "string",
        "null"
      ]
    },
    "admin_enabled": {
      "type": "boolean"
    },
    "anonymous_pull_enabled": {
      "type": "boolean"
    },
    "azuread_authentication_as_arm_policy_enabled": {
      "type": "boolean"
    },
    "data_endpoint_enabled": {
      "type": "boolean"
    },
    "enable_trust_policy": {
      "type": "boolean"
    },
    "export_policy_enabled": {
      "type": "boolean"
    },
    "network_rule_bypass_for_tasks_enabled": {
      "type": "boolean"
    },
    "private_endpoints_inherit_lock": {
      "type": "boolean"
    },
    "private_endpoints_manage_dns_zone_group": {
      "type": "boolean"
    },
    "public_network_access_enabled": {
      "type": "boolean"
    },
    "quarantine_policy_enabled": {
      "type": "boolean"
    },
    "zone_redundancy_enabled": {
      "type": "boolean"
    },
    "cache_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_repository": {
            "type": "string"
          },
          "target_repository": {
            "type": "string"
          },
          "credential_set_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "credential_set_resource_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "source_repository",
          "target_repository"
        ]
      }
    },
    "credential_sets": {
      "type": [
        "object",
        "null"
      ]
    },
    "customer_managed_key": {
      "type": [
        "object",
        "null"
      ]
    },
    "diagnostic_settings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/diagnosticSetting"
      }
    },
    "enable_telemetry": {
      "type": "boolean"
    },
    "georeplications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1
          },
          "regional_endpoint_enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "zone_redundancy_enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "tags": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "location"
        ]
      }
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CanNotDelete",
            "ReadOnly"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "managed_identities": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "system_assigned": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "user_assigned_resource_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]{5,50}$"
    },
    "network_rule_bypass_option": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "AzureServices",
        "None",
        null
      ]
    },
    "network_rule_set": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "default_action": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Allow",
            "Deny",
            null
          ]
        },
        "ip_rule": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "Allow",
                  null
                ]
              },
              "ip_range": {
                "type": "string"
              }
            },
            "required": [
              "ip_range"
            ]
          }
        }
      }
    },
    "private_endpoints": {
      "type": [
        "object",
        "null"
      ]
    },
    "resource_group_name": {
      "type": "string",
      "pattern": "^([-\\w._()]+|/subscriptions/[^/]+/resourceGroups/[^/]+)$"
    },
    "resource_types": {
      "type": [
        "object",
        "null"
      ]
    },
    "retention_policy_in_days": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 365
    },
    "retry": {
      "type": [
        "object",
        "null"
      ]
    },
    "role_assignment_mode": {
      "type": "string",
      "enum": [
        "LegacyRegistryPermissions",
        "AbacRepositoryPermissions"
      ]
    },
    "role_assignments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/roleAssignment"
      }
    },
    "scope_maps": {
      "type": [
        "object",
        "null"
      ]
    },
    "sku": {
      "type": "string",
      "enum": [
        "Basic",
        "Standard",
        "Premium"
      ]
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "timeouts": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}

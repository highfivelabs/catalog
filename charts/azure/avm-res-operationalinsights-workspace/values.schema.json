{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "avm-res-operationalinsights-workspace values (Azure Verified Module v0.5.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "location",
    "resource_group_name"
  ],
  "definitions": {
    "roleAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_definition_id_or_name",
        "principal_id"
      ],
      "properties": {
        "role_definition_id_or_name": {
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "skip_service_principal_aad_check": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegated_managed_identity_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "User",
            "Group",
            "ServicePrincipal",
            "ForeignGroup",
            "Device",
            null
          ]
        }
      }
    },
    "diagnosticSetting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "log_categories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "log_groups": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "metric_categories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "log_analytics_destination_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Dedicated",
            "AzureDiagnostics",
            null
          ]
        },
        "workspace_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "storage_account_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hub_authorization_rule_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hub_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "marketplace_partner_resource_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "names": {
      "description": "The workspace's name in full (not a Terraform variable). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{2,61}[A-Za-z0-9]$",
          "maxLength": 63
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "subscription_id": {
      "description": "The subscription of resource_group_name (not a Terraform variable).",
      "type": [
        "string",
        "null"
      ]
    },
    "customer_managed_key": {
      "type": [
        "object",
        "null"
      ]
    },
    "diagnostic_settings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/diagnosticSetting"
      }
    },
    "enable_telemetry": {
      "type": "boolean"
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CanNotDelete",
            "ReadOnly"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "log_analytics_workspace_allow_resource_only_permissions": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "log_analytics_workspace_cmk_for_query_forced": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "log_analytics_workspace_daily_quota_gb": {
      "type": [
        "number",
        "null"
      ]
    },
    "log_analytics_workspace_data_exports": {
      "type": [
        "object",
        "null"
      ]
    },
    "log_analytics_workspace_dedicated_cluster_resource_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "log_analytics_workspace_identity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SystemAssigned",
            "UserAssigned"
          ]
        },
        "identity_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type"
      ]
    },
    "log_analytics_workspace_internet_ingestion_enabled": {
      "type": "string",
      "enum": [
        "true",
        "false",
        "SecuredByPerimeter"
      ]
    },
    "log_analytics_workspace_internet_query_enabled": {
      "type": "string",
      "enum": [
        "true",
        "false",
        "SecuredByPerimeter"
      ]
    },
    "log_analytics_workspace_linked_storage_accounts": {
      "type": [
        "object",
        "null"
      ]
    },
    "log_analytics_workspace_local_authentication_enabled": {
      "type": "boolean"
    },
    "log_analytics_workspace_reservation_capacity_in_gb_per_day": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        100,
        200,
        300,
        400,
        500,
        1000,
        2000,
        5000,
        null
      ]
    },
    "log_analytics_workspace_retention_in_days": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 7,
      "maximum": 730
    },
    "log_analytics_workspace_sku": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Free",
        "PerNode",
        "Premium",
        "Standard",
        "Standalone",
        "Unlimited",
        "CapacityReservation",
        "PerGB2018",
        null
      ]
    },
    "log_analytics_workspace_tables": {
      "type": [
        "object",
        "null"
      ]
    },
    "log_analytics_workspace_tables_update": {
      "type": [
        "object",
        "null"
      ]
    },
    "log_analytics_workspace_timeouts": {
      "type": [
        "object",
        "null"
      ]
    },
    "monitor_private_link_scope": {
      "type": [
        "object",
        "null"
      ]
    },
    "monitor_private_link_scoped_resource": {
      "type": [
        "object",
        "null"
      ]
    },
    "monitor_private_link_scoped_service_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{2,61}[A-Za-z0-9]$"
    },
    "network_security_perimeter_association": {
      "type": [
        "object",
        "null"
      ]
    },
    "private_endpoint_extensions": {
      "type": [
        "object",
        "null"
      ]
    },
    "private_endpoints": {
      "type": [
        "object",
        "null"
      ]
    },
    "resource_group_name": {
      "type": "string",
      "pattern": "^([-\\w._()]+|/subscriptions/[^/]+/resourceGroups/[^/]+)$"
    },
    "role_assignments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/roleAssignment"
      }
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}

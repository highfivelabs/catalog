{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "avm-ptn-alz-management values (Azure Verified Module v0.10.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "automation_account_name",
    "location",
    "resource_group_name"
  ],
  "properties": {
    "names": {
      "description": "Names in full (not a Terraform variable). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceGroup": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_().-]{0,89}[a-zA-Z0-9_()-]$",
          "maxLength": 90
        },
        "workspace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{2,61}[A-Za-z0-9]$",
          "maxLength": 63
        },
        "automationAccount": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{4,48}[a-zA-Z0-9]$",
          "maxLength": 50
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "subscription_id": {
      "description": "The subscription of resource_group_name (not a Terraform variable).",
      "type": [
        "string",
        "null"
      ]
    },
    "automation_account_name": {
      "description": "The name of the Azure Automation Account to create.",
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "description": "The Azure region where the resources will be deployed.",
      "type": "string",
      "minLength": 1
    },
    "resource_group_name": {
      "description": "The name of the Azure Resource Group where the resources will be created (or its ID).",
      "type": "string",
      "pattern": "^([-\\w._()]+|/subscriptions/[^/]+/resourceGroups/[^/]+)$"
    },
    "automation_account_encryption": {
      "description": "The encryption configuration for the Azure Automation Account.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "key_vault_key_id"
      ],
      "properties": {
        "key_vault_key_id": {
          "type": "string"
        },
        "user_assigned_identity_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "automation_account_identity": {
      "description": "The identity to assign to the Azure Automation Account.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SystemAssigned",
            "UserAssigned",
            "SystemAssigned, UserAssigned"
          ]
        },
        "identity_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "automation_account_local_authentication_enabled": {
      "type": "boolean"
    },
    "automation_account_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "automation_account_public_network_access_enabled": {
      "type": "boolean"
    },
    "automation_account_sku_name": {
      "type": "string",
      "enum": [
        "Basic",
        "Free"
      ]
    },
    "data_collection_rules": {
      "description": "Enables customisation of the data collection rules for Azure Monitor.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_tracking",
        "vm_insights",
        "defender_sql"
      ],
      "properties": {
        "change_tracking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "vm_insights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "defender_sql": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "string"
              }
            },
            "enable_collection_of_sql_queries_for_security_research": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "enable_telemetry": {
      "type": "boolean"
    },
    "linked_automation_account_creation_enabled": {
      "type": "boolean"
    },
    "log_analytics_solution_plans": {
      "description": "The Log Analytics Solution Plans to create.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product"
        ],
        "properties": {
          "product": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "log_analytics_workspace_allow_resource_only_permissions": {
      "type": "boolean"
    },
    "log_analytics_workspace_cmk_for_query_forced": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "log_analytics_workspace_creation_enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "log_analytics_workspace_daily_quota_gb": {
      "type": [
        "number",
        "null"
      ]
    },
    "log_analytics_workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "log_analytics_workspace_internet_ingestion_enabled": {
      "type": "boolean"
    },
    "log_analytics_workspace_internet_query_enabled": {
      "type": "boolean"
    },
    "log_analytics_workspace_local_authentication_enabled": {
      "type": "boolean"
    },
    "log_analytics_workspace_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "log_analytics_workspace_reservation_capacity_in_gb_per_day": {
      "type": [
        "number",
        "null"
      ]
    },
    "log_analytics_workspace_retention_in_days": {
      "type": "number"
    },
    "log_analytics_workspace_sku": {
      "type": "string"
    },
    "resource_group_creation_enabled": {
      "type": "boolean"
    },
    "sentinel_onboarding": {
      "description": "Enables and customizes the Sentinel onboarding; null disables it.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "customer_managed_key_enabled": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "timeouts": {
      "description": "Refused when set: Azure Service Operator has no per-request timeouts.",
      "type": [
        "object",
        "null"
      ]
    },
    "user_assigned_managed_identities": {
      "description": "Enables customisation of the user assigned managed identities.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ama"
      ],
      "properties": {
        "ama": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}

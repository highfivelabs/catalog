{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "avm-res-resources-resourcegroup values (Azure Verified Module v0.5.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location",
    "name"
  ],
  "definitions": {
    "roleAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_definition_id_or_name",
        "principal_id"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "The role assignment's name, a GUID; ASO gives it a stable UUID when unset."
        },
        "role_definition_id_or_name": {
          "type": "string",
          "pattern": "^((/subscriptions/[0-9a-fA-F-]+)?/providers/Microsoft\\.Authorization/roleDefinitions/[0-9a-fA-F-]+|[A-Za-z].*)$"
        },
        "principal_id": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "skip_service_principal_aad_check": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Accepted; no effect, as in the module's azapi resources."
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegated_managed_identity_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "User",
            "Group",
            "ServicePrincipal",
            "ForeignGroup",
            "Device",
            null
          ]
        }
      }
    }
  },
  "properties": {
    "names": {
      "description": "The resource group's name in full (not a Terraform variable; docs/design.md, \"Names, labels and tags\"). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceGroup": {
          "description": "1 to 90 letters, digits, underscores, parentheses, hyphens and periods, not ending with a period.",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_().-]{0,89}[a-zA-Z0-9_()-]$",
          "maxLength": 90
        }
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of the group's name, never one set under names. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "description": "Kubernetes labels on every object; ASO never copies them to Azure.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "enable_telemetry": {
      "type": "boolean",
      "description": "Accepted; the chart sends no telemetry."
    },
    "ignore_tag_changes": {
      "type": "boolean"
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "Required. The Azure region for deployment of the this resource."
    },
    "lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CanNotDelete",
            "ReadOnly"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "managed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_().-]{1,89}[a-zA-Z0-9_()-]$",
      "description": "Required. The name of the this resource."
    },
    "retry": {
      "type": [
        "object",
        "null"
      ],
      "description": "Refused when set: ASO retries itself. {error_message_regex, interval_seconds, max_interval_seconds}"
    },
    "role_assignments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/roleAssignment"
      }
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "(Optional) Tags of the resource."
    },
    "timeouts": {
      "type": [
        "object",
        "null"
      ],
      "description": "Refused when set: ASO has no per-request timeouts. {create, delete, read, update}"
    }
  }
}

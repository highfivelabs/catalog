{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "avm-res-network-privateendpoint values (Azure Verified Module v0.3.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "location",
    "parent_id",
    "private_connection_resource_id",
    "subnet_resource_id"
  ],
  "definitions": {
    "roleAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_definition_id_or_name",
        "principal_id"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "role_definition_id_or_name": {
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "skip_service_principal_aad_check": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegated_managed_identity_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "User",
            "Group",
            "ServicePrincipal",
            "ForeignGroup",
            "Device",
            null
          ]
        }
      }
    },
    "ipConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "private_ip_address",
        "subresource_name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "private_ip_address": {
          "type": "string",
          "minLength": 1
        },
        "subresource_name": {
          "type": "string",
          "minLength": 1
        },
        "member_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "names": {
      "description": "The private endpoint's and its network interface's names in full (not Terraform variables). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privateEndpoint": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9_.-]{0,78}[a-zA-Z0-9_])?$",
          "maxLength": 80
        },
        "networkInterface": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9_.-]{0,78}[a-zA-Z0-9_])?$",
          "maxLength": 80
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "application_security_group_association_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avm_managed_migration_enabled": {
      "type": "boolean"
    },
    "enable_telemetry": {
      "type": "boolean"
    },
    "ignore_body_changes": {
      "type": [
        "object",
        "null"
      ]
    },
    "ip_configurations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ipConfiguration"
      }
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CanNotDelete",
            "ReadOnly"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9_.-]{0,78}[a-zA-Z0-9_])?$",
      "maxLength": 80
    },
    "network_interface_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "parent_id": {
      "type": "string",
      "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+$"
    },
    "private_connection_resource_id": {
      "type": "string",
      "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/[^/]+/[^/]+/[^/]+"
    },
    "private_dns_zone_group_name": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 80
    },
    "private_dns_zone_resource_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "private_service_connection_name": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 80
    },
    "resource_types": {
      "type": [
        "object",
        "null"
      ]
    },
    "retry": {
      "type": [
        "object",
        "null"
      ]
    },
    "role_assignments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/roleAssignment"
      }
    },
    "subnet_resource_id": {
      "type": "string",
      "minLength": 1
    },
    "subresource_names": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "timeouts": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}

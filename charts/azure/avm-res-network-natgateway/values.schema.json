        "storage_account_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hub_authorization_rule_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hub_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "marketplace_partner_resource_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "names": {
      "description": "The NAT gateway's name in full (not a Terraform variable). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "natGateway": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9_.-]{0,78}[a-zA-Z0-9_])?$",
          "maxLength": 80
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "diagnostic_settings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/diagnosticSetting"
      }
    },
    "enable_telemetry": {
      "type": "boolean"
    },
    "idle_timeout_in_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 4,
      "maximum": 120
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CanNotDelete",
            "ReadOnly"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9_.-]{0,78}[a-zA-Z0-9_])?$"
    },
    "parent_id": {
      "type": "string",
      "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+$"
    },
    "public_ip_configuration": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allocation_method": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Static",
              "Dynamic",
              null
            ]
          },
          "ddos_protection_mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Disabled",
              "Enabled",
              "VirtualNetworkInherited",
              null
            ]
          },
          "ddos_protection_plan_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "domain_name_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "idle_timeout_in_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 4,
            "maximum": 30
          },
          "inherit_tags": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "ip_version": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "IPv4",
              "IPv6",
              null
            ]
          },
          "lock": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "CanNotDelete",
                  "ReadOnly"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "sku": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Basic",
              "Standard",
              "StandardV2",
              null
            ]
          },
          "sku_tier": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Global",
              "Regional",
              null
            ]
          },
          "tags": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "zones": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "public_ip_prefix_resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/Microsoft\\.Network/publicIP(Addresses|Prefixes)/[^/]+$"
      }
    },
    "public_ip_prefix_v6_resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/Microsoft\\.Network/publicIP(Addresses|Prefixes)/[^/]+$"
      }
    },
    "public_ip_resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/Microsoft\\.Network/publicIP(Addresses|Prefixes)/[^/]+$"
      }
    },
    "public_ip_v6_resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/Microsoft\\.Network/publicIP(Addresses|Prefixes)/[^/]+$"
      }
    },
    "public_ips": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9_.-]{0,78}[a-zA-Z0-9_])?$"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "role_assignments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/roleAssignment"
      }
    },
    "sku_name": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Standard",
        "StandardV2",
        null
      ]
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }

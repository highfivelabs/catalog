{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "avm-res-network-bastionhost values (Azure Verified Module v0.9.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "location",
    "parent_id"
  ],
  "properties": {
    "names": {
      "description": "The bastion host's name in full (not a Terraform variable). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bastionHost": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,78}[a-zA-Z0-9_])?$",
          "maxLength": 80
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "copy_paste_enabled": {
      "type": "boolean"
    },
    "diagnostic_settings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/diagnosticSetting"
      }
    },
    "enable_telemetry": {
      "type": "boolean"
    },
    "file_copy_enabled": {
      "type": "boolean"
    },
    "ip_configuration": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "subnet_id"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "subnet_id": {
          "type": "string"
        },
        "create_public_ip": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "public_ip_tags": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "public_ip_merge_with_module_tags": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "public_ip_address_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "public_ip_address_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ip_connect_enabled": {
      "type": "boolean"
    },
    "kerberos_enabled": {
      "type": "boolean"
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CanNotDelete",
            "ReadOnly"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,78}[a-zA-Z0-9_])?$"
    },
    "parent_id": {
      "type": "string",
      "pattern": "(?i)^/subscriptions/[^/]+/resourceGroups/[^/]+$"
    },
    "private_only_enabled": {
      "type": "boolean"
    },
    "role_assignments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/roleAssignment"
      }
    },
    "scale_units": {
      "type": "integer"
    },
    "session_recording_enabled": {
      "type": "boolean"
    },
    "shareable_link_enabled": {
      "type": "boolean"
    },
    "sku": {
      "type": "string",
      "enum": [
        "Basic",
        "Standard",
        "Developer",
        "Premium"
      ]
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "tunneling_enabled": {
      "type": "boolean"
    },
    "virtual_network_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "zones": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": [
          "string",
          "integer"
        ]
      }
    }
  },
  "definitions": {
    "roleAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_definition_id_or_name",
        "principal_id"
      ],
      "properties": {
        "role_definition_id_or_name": {
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "skip_service_principal_aad_check": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegated_managed_identity_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "User",
            "Group",
            "ServicePrincipal",
            "ForeignGroup",
            "Device",
            null
          ]
        }
      }
    },
    "diagnosticSetting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "log_categories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "log_groups": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "metric_categories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "log_analytics_destination_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Dedicated",
            "AzureDiagnostics",
            null
          ]
        },
        "workspace_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "storage_account_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hub_authorization_rule_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hub_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "marketplace_partner_resource_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "avm-res-network-publicipaddress values (Azure Verified Module v0.2.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "location",
    "resource_group_name"
  ],
  "definitions": {
    "roleAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_definition_id_or_name",
        "principal_id"
      ],
      "properties": {
        "role_definition_id_or_name": {
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "skip_service_principal_aad_check": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegated_managed_identity_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "User",
            "Group",
            "ServicePrincipal",
            "ForeignGroup",
            "Device",
            null
          ]
        }
      }
    },
    "diagnosticSetting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "log_categories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "log_groups": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "metric_categories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "log_analytics_destination_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Dedicated",
            "AzureDiagnostics",
            null
          ]
        },
        "workspace_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "storage_account_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hub_authorization_rule_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hub_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "marketplace_partner_resource_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "names": {
      "description": "The public IP's name in full (not a Terraform variable). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicIp": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,78}[a-zA-Z0-9_])?$",
          "maxLength": 80
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "subscription_id": {
      "description": "The subscription of resource_group_name (not a Terraform variable).",
      "type": [
        "string",
        "null"
      ]
    },
    "allocation_method": {
      "type": "string",
      "enum": [
        "Static",
        "Dynamic"
      ]
    },
    "ddos_protection_mode": {
      "type": "string",
      "enum": [
        "Disabled",
        "Enabled",
        "VirtualNetworkInherited"
      ]
    },
    "ddos_protection_plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "diagnostic_settings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/diagnosticSetting"
      }
    },
    "domain_name_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "edge_zone": {
      "type": [
        "string",
        "null"
      ]
    },
    "enable_telemetry": {
      "type": "boolean"
    },
    "idle_timeout_in_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "ip_tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "ip_version": {
      "type": "string",
      "enum": [
        "IPv4",
        "IPv6"
      ]
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CanNotDelete",
            "ReadOnly"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,78}[a-zA-Z0-9_])?$"
    },
    "public_ip_prefix_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resource_group_name": {
      "type": "string",
      "pattern": "^([-\\w._()]+|/subscriptions/[^/]+/resourceGroups/[^/]+)$"
    },
    "reverse_fqdn": {
      "type": [
        "string",
        "null"
      ]
    },
    "role_assignments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/roleAssignment"
      }
    },
    "sku": {
      "type": "string",
      "enum": [
        "Basic",
        "Standard"
      ]
    },
    "sku_tier": {
      "type": "string",
      "enum": [
        "Global",
        "Regional"
      ]
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "zones": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer"
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "avm-res-network-routetable values (Azure Verified Module v0.6.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "location",
    "resource_group_name"
  ],
  "definitions": {
    "roleAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_definition_id_or_name",
        "principal_id"
      ],
      "properties": {
        "role_definition_id_or_name": {
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "skip_service_principal_aad_check": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegated_managed_identity_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "User",
            "Group",
            "ServicePrincipal",
            "ForeignGroup",
            "Device",
            null
          ]
        }
      }
    }
  },
  "properties": {
    "names": {
      "description": "The route table's name in full (not a Terraform variable). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routeTable": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9_.-]{0,78}[a-zA-Z0-9_])?$",
          "maxLength": 80
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "subscription_id": {
      "description": "The subscription of resource_group_name (not a Terraform variable).",
      "type": [
        "string",
        "null"
      ]
    },
    "bgp_route_propagation_enabled": {
      "type": "boolean"
    },
    "enable_telemetry": {
      "type": "boolean"
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CanNotDelete",
            "ReadOnly"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9_.-]{0,78}[a-zA-Z0-9_])?$"
    },
    "resource_group_name": {
      "type": "string",
      "pattern": "^([-\\w._()]+|/subscriptions/[^/]+/resourceGroups/[^/]+)$"
    },
    "role_assignments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/roleAssignment"
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address_prefix": {
            "type": "string",
            "minLength": 1
          },
          "next_hop_type": {
            "type": "string",
            "enum": [
              "VirtualNetworkGateway",
              "VnetLocal",
              "Internet",
              "VirtualAppliance",
              "None"
            ]
          },
          "next_hop_in_ip_address": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "address_prefix",
          "next_hop_type"
        ]
      }
    },
    "routes_legacy_mode": {
      "type": "boolean"
    },
    "subnet_resource_ids": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}

    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key_type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[0-9a-zA-Z-]{1,127}$"
        },
        "key_type": {
          "type": "string",
          "enum": [
            "EC",
            "EC-HSM",
            "RSA",
            "RSA-HSM"
          ]
        },
        "key_opts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "enum": [
              "decrypt",
              "encrypt",
              "sign",
              "unwrapKey",
              "verify",
              "wrapKey",
              "import"
            ]
          }
        },
        "key_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "curve": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "P-256",
            "P-256K",
            "P-384",
            "P-521",
            null
          ]
        },

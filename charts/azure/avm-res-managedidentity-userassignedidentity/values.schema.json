{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "avm-res-managedidentity-userassignedidentity values (Azure Verified Module v0.6.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "location",
    "resource_group_name"
  ],
  "definitions": {},
  "properties": {
    "names": {
      "description": "The identity's name in full (not a Terraform variable). A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userAssignedIdentity": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$",
          "maxLength": 128
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "deletion_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "subscription_id": {
      "description": "The subscription of resource_group_name (not a Terraform variable).",
      "type": [
        "string",
        "null"
      ]
    },
    "enable_telemetry": {
      "type": "boolean"
    },
    "federated_identity_credentials": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "audience": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,119}$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "audience",
          "issuer",
          "name",
          "subject"
        ]
      }
    },
    "isolation_scope": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Regional",
        null
      ]
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CanNotDelete",
            "ReadOnly"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "outbound_role_assignments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role_definition_id_or_name": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "delegated_managed_identity_resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "skip_service_principal_aad_check": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "role_definition_id_or_name",
          "scope"
        ]
      }
    },
    "resource_group_name": {
      "type": "string",
      "pattern": "^([-\\w._()]+|/subscriptions/[^/]+/resourceGroups/[^/]+)$"
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}

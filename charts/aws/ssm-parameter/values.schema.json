{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ssm-parameter values (terraform-aws-modules ssm-parameter v2.1.2)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "names": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "maxLength": 63
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "deletion_policy": {
      "type": "string",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT"
      ]
    },
    "allowed_pattern": {
      "type": [
        "string",
        "null"
      ],
      "description": "Regular expression used to validate the parameter value"
    },
    "create": {
      "type": "boolean",
      "description": "Whether to create SSM Parameter"
    },
    "data_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "text",
        "aws:ssm:integration",
        "aws:ec2:image",
        null
      ],
      "description": "Data type of the parameter"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Description of the parameter"
    },
    "ignore_value_changes": {
      "type": "boolean",
      "description": "Not supported: ACK's controller sets the value in the spec on every sync"
    },
    "key_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "KMS key ID or ARN for encrypting a parameter (when type is SecureString)"
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Name of SSM parameter"
    },
    "overwrite": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Not supported: ACK's Parameter has no overwrite field"
    },
    "region": {
      "type": [
        "string",
        "null"
      ],
      "description": "Region where the resource(s) will be managed (the services.k8s.aws/region annotation); unset, the namespace's or the controller's"
    },
    "secure_type": {
      "type": "boolean",
      "description": "Whether the type of the value should be considered as secure or not"
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "A mapping of tags to assign to all resources"
    },
    "tier": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Standard",
        "Advanced",
        "Intelligent-Tiering",
        null
      ],
      "description": "Parameter tier to assign to the parameter"
    },
    "type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "String",
        "StringList",
        "SecureString",
        null
      ],
      "description": "Type of the parameter"
    },
    "value": {
      "type": [
        "string",
        "null"
      ],
      "description": "Value of the parameter"
    },
    "value_wo_version": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Version of the write-only value (accepted; no effect on ACK)"
    },
    "values": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of values of the parameter (will be jsonencoded to store as string natively in SSM)"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "iam-policy values (terraform-aws-modules iam v6.8.2, modules/iam-policy)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "names": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "maxLength": 63
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "deletion_policy": {
      "type": "string",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT"
      ]
    },
    "create": {
      "type": "boolean",
      "description": "Whether to create the IAM policy"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "The description of the policy"
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "The name of the policy"
    },
    "name_prefix": {
      "type": [
        "string",
        "null"
      ],
      "description": "Not supported: a policy name with Terraform's random suffix (name_prefix) would change between renders; set name (the namePrefix value keeps two Instances' policies apart)"
    },
    "path": {
      "type": [
        "string",
        "null"
      ],
      "description": "The path of the policy in IAM"
    },
    "policy": {
      "type": [
        "string",
        "null"
      ],
      "description": "The policy document (JSON)"
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "A map of tags to add to all resources."
    }
  }
}

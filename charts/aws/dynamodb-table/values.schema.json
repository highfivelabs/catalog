{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dynamodb-table values (terraform-aws-modules dynamodb-table v5.5.2)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "names": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "maxLength": 63
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "account_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{12}$"
    },
    "partition": {
      "type": "string",
      "enum": [
        "aws",
        "aws-cn",
        "aws-us-gov"
      ]
    },
    "deletion_policy": {
      "type": "string",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT"
      ]
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "S",
              "N",
              "B"
            ]
          }
        }
      },
      "description": "List of nested attribute definitions"
    },
    "autoscaling_defaults": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      },
      "description": "A map of default autoscaling settings"
    },
    "autoscaling_enabled": {
      "type": "boolean",
      "description": "Not supported (not ported yet): Application Auto Scaling"
    },
    "autoscaling_indexes": {
      "type": "object",
      "description": "Not supported (not ported yet): Application Auto Scaling"
    },
    "autoscaling_read": {
      "type": "object",
      "description": "Not supported (not ported yet): Application Auto Scaling"
    },
    "autoscaling_write": {
      "type": "object",
      "description": "Not supported (not ported yet): Application Auto Scaling"
    },
    "billing_mode": {
      "type": "string",
      "enum": [
        "PROVISIONED",
        "PAY_PER_REQUEST"
      ],
      "description": "Controls how you are billed for read/write throughput"
    },
    "create_table": {
      "type": "boolean",
      "description": "Controls if DynamoDB table and associated resources are created"
    },
    "deletion_protection_enabled": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Enables deletion protection for table"
    },
    "global_secondary_indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "hash_key",
          "projection_type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "hash_key": {
            "type": "string"
          },
          "range_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "projection_type": {
            "type": "string",
            "enum": [
              "ALL",
              "KEYS_ONLY",
              "INCLUDE"
            ]
          },
          "non_key_attributes": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "read_capacity": {
            "type": [
              "integer",
              "null"
            ]
          },
          "write_capacity": {
            "type": [
              "integer",
              "null"
            ]
          },
          "on_demand_throughput": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_read_request_units": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "max_write_request_units": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "warm_throughput": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "read_units_per_second": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "write_units_per_second": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "description": "Not supported: ACK's Table has no warm throughput field"
          }
        }
      },
      "description": "Describe a GSI for the table"
    },
    "global_table_witness": {
      "type": [
        "object",
        "null"
      ],
      "description": "Not supported: ACK's Table has no witness region field"
    },
    "hash_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "The attribute to use as the hash (partition) key. Must also be defined as an attribute"
    },
    "ignore_changes_global_secondary_index": {
      "type": "boolean",
      "description": "Not supported: the controller reconciles the indexes to the spec"
    },
    "import_table": {
      "type": "object",
      "description": "Not supported: ACK's Table has no import from S3"
    },
    "local_secondary_indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "range_key",
          "projection_type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "range_key": {
            "type": "string"
          },
          "projection_type": {
            "type": "string",
            "enum": [
              "ALL",
              "KEYS_ONLY",
              "INCLUDE"
            ]
          },
          "non_key_attributes": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Describe an LSI on the table"
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Name of the DynamoDB table"
    },
    "on_demand_throughput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_read_request_units": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_write_request_units": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "point_in_time_recovery_enabled": {
      "type": "boolean",
      "description": "Whether to enable point-in-time recovery"
    },
    "point_in_time_recovery_period_in_days": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 35,
      "description": "Number of preceding days for which continuous backups are taken and maintained"
    },
    "range_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "The attribute to use as the range (sort) key. Must also be defined as an attribute"
    },
    "read_capacity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "The number of read units for this table"
    },
    "region": {
      "type": [
        "string",
        "null"
      ],
      "description": "Region where the resource(s) will be managed (the services.k8s.aws/region annotation); unset, the namespace's or the controller's"
    },
    "replica_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region_name"
        ],
        "properties": {
          "region_name": {
            "type": "string"
          },
          "kms_key_arn": {
            "type": [
              "string",
              "null"
            ]
          },
          "propagate_tags": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "point_in_time_recovery": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "deletion_protection_enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "consistency_mode": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "description": "Region names for creating replicas for a global DynamoDB table"
    },
    "resource_policy": {
      "type": [
        "string",
        "null"
      ],
      "description": "The JSON definition of the resource-based policy"
    },
    "restore_date_time": {
      "type": [
        "string",
        "null"
      ],
      "description": "Not supported: ACK's Table has no restore"
    },
    "restore_source_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Not supported: ACK's Table has no restore"
    },
    "restore_source_table_arn": {
      "type": [
        "string",
        "null"
      ],
      "description": "Not supported: ACK's Table has no restore"
    },
    "restore_to_latest_time": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Not supported: ACK's Table has no restore"
    },
    "server_side_encryption_enabled": {
      "type": "boolean",
      "description": "Whether or not to enable encryption at rest using an AWS managed KMS customer master key (CMK)"
    },
    "server_side_encryption_kms_key_arn": {
      "type": [
        "string",
        "null"
      ],
      "description": "The ARN of the CMK that should be used for the AWS KMS encryption"
    },
    "stream_enabled": {
      "type": "boolean",
      "description": "Indicates whether Streams are to be enabled (true) or disabled (false)"
    },
    "stream_view_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "KEYS_ONLY",
        "NEW_IMAGE",
        "OLD_IMAGE",
        "NEW_AND_OLD_IMAGES",
        null
      ],
      "description": "StreamViewType"
    },
    "table_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "STANDARD",
        "STANDARD_INFREQUENT_ACCESS",
        null
      ],
      "description": "The storage class of the table"
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "A mapping of tags to assign to all resources"
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Terraform's resource timeouts (accepted; no effect on ACK)"
    },
    "ttl_attribute_name": {
      "type": "string",
      "description": "The name of the table attribute to store the TTL timestamp in"
    },
    "ttl_enabled": {
      "type": "boolean",
      "description": "Indicates whether ttl is enabled"
    },
    "warm_throughput": {
      "type": "object",
      "description": "Not supported: ACK's Table has no warm throughput field"
    },
    "write_capacity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "The number of write units for this table"
    }
  }
}

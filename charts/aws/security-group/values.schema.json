{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "security-group values (terraform-aws-modules security-group v6.0.0)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "names": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "securityGroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "maxLength": 63
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "deletion_policy": {
      "type": "string",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT"
      ]
    },
    "create": {
      "type": "boolean",
      "description": "Controls if resources should be created (affects nearly all resources)"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Description of security group"
    },
    "egress_rules": {
      "type": "object",
      "description": "Map of egress rules to add to the security group",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "cidr_ipv4": {
            "type": [
              "string",
              "null"
            ]
          },
          "cidr_ipv6": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "from_port": {
            "type": [
              "integer",
              "null"
            ]
          },
          "ip_protocol": {
            "type": [
              "string",
              "null"
            ]
          },
          "prefix_list_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "referenced_security_group_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "to_port": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "enable_exclusive_rules": {
      "type": "boolean",
      "description": "Not supported: ACK keeps the group's rules inline and owns all of them, as enable_exclusive_rules: true does; letting rules added elsewhere stay has no ACK equivalent",
      "enum": [
        true,
        false
      ]
    },
    "ingress_rules": {
      "type": "object",
      "description": "Map of ingress rules to add to the security group",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "cidr_ipv4": {
            "type": [
              "string",
              "null"
            ]
          },
          "cidr_ipv6": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "from_port": {
            "type": [
              "integer",
              "null"
            ]
          },
          "ip_protocol": {
            "type": [
              "string",
              "null"
            ]
          },
          "prefix_list_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "referenced_security_group_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "to_port": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "name": {
      "type": "string",
      "description": "Name of security group"
    },
    "putin_khuylo": {
      "type": "boolean",
      "description": "Do you agree that Putin doesn't respect Ukrainian sovereignty and territorial integrity? More info: https://en.wikipedia.org/wiki/Putin_khuylo!"
    },
    "region": {
      "type": [
        "string",
        "null"
      ],
      "description": "Region where the resource(s) will be managed. Defaults to the Region set in the provider configuration"
    },
    "revoke_rules_on_delete": {
      "type": "boolean",
      "description": "Not supported: ACK's SecurityGroup has no field to revoke its rules before it is deleted",
      "enum": [
        true,
        false
      ]
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "A map of tags to add to all resources"
    },
    "timeouts": {
      "type": [
        "object",
        "null"
      ],
      "description": "Not supported: Terraform's create and delete timeouts: ACK retries until the group is synced, and Bundt waits for it"
    },
    "use_name_prefix": {
      "type": "boolean",
      "description": "Whether to use the name (`name`) as a prefix, appending a random suffix"
    },
    "vpc_associations": {
      "type": [
        "object",
        "null"
      ],
      "description": "Not supported: aws_vpc_security_group_vpc_association has no ACK or ack-extensions kind"
    },
    "vpc_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ID of the VPC where the security group is created"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sns values (terraform-aws-modules sns v7.2.0)",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "variable",
        "values"
      ],
      "properties": {
        "test": {
          "type": "string"
        },
        "variable": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sid": {
          "type": [
            "string",
            "null"
          ]
        },
        "actions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "not_actions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "effect": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Allow",
            "Deny",
            null
          ]
        },
        "resources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "not_resources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "principals": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "identifiers"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "identifiers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "not_principals": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "identifiers"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "identifiers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "condition": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        "conditions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/condition"
          }
        }
      }
    }
  },
  "properties": {
    "names": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+(\\.fifo)?$"
        }
      }
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "maxLength": 63
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "account_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{12}$"
    },
    "partition": {
      "type": "string",
      "enum": [
        "aws",
        "aws-cn",
        "aws-us-gov"
      ]
    },
    "deletion_policy": {
      "type": "string",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT"
      ]
    },
    "application_feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_sample_rate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      },
      "description": "Map of IAM role ARNs and sample rate for success and failure feedback"
    },
    "archive_policy": {
      "type": [
        "string",
        "null"
      ],
      "description": "Not supported: ACK's Topic has no archive policy field"
    },
    "content_based_deduplication": {
      "type": "boolean",
      "description": "Boolean indicating whether or not to enable content-based deduplication for FIFO topics"
    },
    "create": {
      "type": "boolean",
      "description": "Determines whether resources will be created (affects all resources)"
    },
    "create_subscription": {
      "type": "boolean",
      "description": "Determines whether an SNS subscription is created"
    },
    "create_topic_policy": {
      "type": "boolean",
      "description": "Determines whether an SNS topic policy is created"
    },
    "data_protection_policy": {
      "type": [
        "string",
        "null"
      ],
      "description": "A map of data protection policy statements"
    },
    "delivery_policy": {
      "type": [
        "string",
        "null"
      ],
      "description": "The SNS delivery policy"
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "The display name for the SNS topic"
    },
    "enable_default_topic_policy": {
      "type": "boolean",
      "description": "Specifies whether to enable the default topic policy. Defaults to `true`"
    },
    "fifo_throughput_scope": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Topic",
        "MessageGroup",
        null
      ],
      "description": "Enables higher throughput for FIFO topics by adjusting the scope of deduplication"
    },
    "fifo_topic": {
      "type": "boolean",
      "description": "Boolean indicating whether or not to create a FIFO (first-in-first-out) topic"
    },
    "firehose_feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_sample_rate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      },
      "description": "Map of IAM role ARNs and sample rate for success and failure feedback"
    },
    "http_feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_sample_rate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      },
      "description": "Map of IAM role ARNs and sample rate for success and failure feedback"
    },
    "kms_master_key_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "The ID of an AWS-managed customer master key (CMK) for Amazon SNS or a custom CMK"
    },
    "lambda_feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_sample_rate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      },
      "description": "Map of IAM role ARNs and sample rate for success and failure feedback"
    },
    "maximum_message_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1024,
      "maximum": 1048576,
      "description": "The maximum size, in bytes, of a message that can be published to the topic"
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "The name of the SNS topic to create (required, or names.topic)"
    },
    "override_topic_policy_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of IAM policy documents that are merged together into the exported document. In merging, statements with non-blank `sid`s will override statements with the same `sid`"
    },
    "region": {
      "type": [
        "string",
        "null"
      ],
      "description": "Region where the resource(s) will be managed (the services.k8s.aws/region annotation); unset, the namespace's or the controller's"
    },
    "signature_version": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        1,
        2,
        null
      ],
      "description": "If SignatureVersion should be `1` (`SHA1`) or `2` (`SHA256`)"
    },
    "source_topic_policy_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of IAM policy documents that are merged together into the exported document. Statements must have unique `sid`s"
    },
    "sqs_feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_sample_rate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      },
      "description": "Map of IAM role ARNs and sample rate for success and failure feedback"
    },
    "subscriptions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint",
          "protocol"
        ],
        "properties": {
          "confirmation_timeout_in_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Not supported: Terraform's wait for an HTTP(S) endpoint to confirm"
          },
          "delivery_policy": {
            "type": [
              "string",
              "null"
            ]
          },
          "endpoint": {
            "type": "string"
          },
          "endpoint_auto_confirms": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Not supported: Terraform's wait for an HTTP(S) endpoint to confirm"
          },
          "filter_policy": {
            "type": [
              "string",
              "null"
            ]
          },
          "filter_policy_scope": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "MessageAttributes",
              "MessageBody",
              null
            ]
          },
          "protocol": {
            "type": "string"
          },
          "raw_message_delivery": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "redrive_policy": {
            "type": [
              "string",
              "null"
            ]
          },
          "replay_policy": {
            "type": [
              "string",
              "null"
            ],
            "description": "Not supported: ACK's Subscription has no replay policy field"
          },
          "subscription_role_arn": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "description": "A map of subscription definitions to create"
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "A mapping of tags to assign to all resources"
    },
    "topic_policy": {
      "type": [
        "string",
        "null"
      ],
      "description": "An externally created fully-formed AWS policy as JSON"
    },
    "topic_policy_statements": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/statement"
      },
      "description": "A map of IAM policy statements for custom permission usage"
    },
    "tracing_config": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PassThrough",
        "Active",
        null
      ],
      "description": "Tracing mode of an Amazon SNS topic"
    },
    "use_name_prefix": {
      "type": "boolean",
      "description": "Not supported: a topic name with Terraform's random suffix (name_prefix) would change between renders; set name (the namePrefix value keeps two Instances' topics apart)"
    }
  }
}

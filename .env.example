# Environment identifiers for live tests and offload runs. Copy to .env
# (git-ignored; Taskfile.yml and hack/ci/gate.sh load it) and fill in.
# Placeholders only: never commit real values.

# The Google Cloud project live tests run in (hack/live-apply.sh refuses
# any other, except HFL_GCP_TEST_PROJECT when the test estate's env file
# sets it).
GCP_PROJECT=my-dev-project
# The service account `task test-live` runs as on the offload VM (no keys).
GCP_LIVE_SA=catalog-live-tests@my-dev-project.iam.gserviceaccount.com
# The service account the kcc-tf-kind spike runs as
# (hack/terraform/spikes/kcc-tf-kind/run.sh).
GCP_CCE_LIVE_SA=cce-live-tests@my-dev-project.iam.gserviceaccount.com
# The offload project and bucket (the names scripts/offload reads): run
# logs and the config-connector-extensions snapshot go to the bucket.
OFFLOAD_PROJECT=my-dev-project
OFFLOAD_BUCKET=gs://my-dev-project-offload

# Azure live tests (task test-live-azure, hack/azure-live.sh): the sandbox
# subscription, its tenant, the app registration the offload VMs' service
# account is federated to (no secret), the one resource group it may touch,
# and that service account (offload --sa).
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_LIVE_RESOURCE_GROUP=my-live-tests
AZURE_LIVE_SA=offload@my-dev-project.iam.gserviceaccount.com
